1          /* SAS program to accompany the article
2             "Avoid alphabetical order for a categorical axes in a statistical graph"
3             by Rick Wicklin, published 13NOV2023 on The DO Loop blog:
4             https://blogs.sas.com/content/iml/2023/11/13/avoid-alphabetical-order.html
5          
6             This program shows why you should avoid using alphabetical ordering for bar charts, or
7             "Why 'Alabama first' is not always the best way to display data"
8             Avoiding 'Alabama first' was often advocated by Howard Wainer.
9          
10            For a different example see how sorting affects lasagna plots:
11            https://blogs.sas.com/content/iml/2016/06/08/lasagna-plot-in-sas.html
12         
13            Data from
14            https://www.census.gov/data/tables/time-series/demo/popest/2020s-state-total.html
15            https://en.wikipedia.org/wiki/List_of_U.S._states_and_territories_by_area
16         
17            Lessons:
18            1. For many categories, use tall graphs an horizontal bar charts.
19            2. Set FITPOLICY=NONE, then increase graph height and/or decrease label font.
20            3. Almost always, use the CATEGORYORDER= option to display the categories in a meaningful order.
21            4. If the graph type is not a traditional bar chart, use the COLORBANDS= option to
22               guide the viewer's eyes to the data.
                                                           The SAS System

23            5. For other category orders, sort data and use CATEGORYORDER=DATA on XAXIS or YAXIS stmts.
24         */
25         
26         data StatePop;
27         infile datalines delimiter = ","	missover dsd;
28         length StateName $20;
29         input StateID StateName Pop2020 PopChange2020 LandArea;
30         PopM = Pop2020 / 1E6;
31         label PopM = "Population (Millions)"
32               PopChange2020 = "Population Change (2020)"
33               LandArea = "Land Area (km^2)";
34         format PopChange2020 comma7.;
35         datalines;

