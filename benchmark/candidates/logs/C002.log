6          /*  Basic area bar chart                           */
7          /*  notes:                                         */
8          /*  - The values for the response and width        */
9          /*    input variables are summed.                  */
10         /*  - The response output column contains the      */
11         /*    response values for labeling.                */
12         /*  - The width output column contains the width   */
13         /*    values for labeling.                         */
14         /*                                                 */
15         /*  args:                                          */
16         /*  input - input data set name                    */
17         /*  output - output data set name                  */
18         /*  category - category variable for each bar      */
19         /*  response - variable for the length of each bar */
20         /*  width - variable for the width of each bar     */
21         /***************************************************/
22         %macro genAreaBarDataBasic(input, output, category, response, width);
                                                           The SAS System

23         proc summary data=&input nway;
24         class &category;
25         var &response &width;
26         output out=_out_totals_ sum=;
27         run;
28         
29         data &output;
30         retain x 0;
31         label x="&width" y="&response" ID="&category";
32         set _out_totals_;
33         ID=&category;
34         response=&response;
35         width=&width;
36         y=0;
37         x=x;
38         output;
39         y=&response;
40         output;
41         x = x + &width;
42         output;
43         y=0;
44         output;
45         run;
46         %mend;
