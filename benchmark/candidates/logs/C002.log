144        
145        data _merged_;
146        merge _out_totals_ _out_width_;
147        by &category;
148        run;
149        
150        data &output;
151        retain curCategory curLabelX curLabelY;
152        retain x 0 y 0 prevY 0 nextY 0 prevX 0;
153        label x="&width" y="&response" ID="&subgroup";
154        set _merged_ end=_last_;
155        ID=&subgroup;
156        if (curCategory ne &category) then do;
157           if x > 0 then do;
158              label = curCategory;
159              labelX = curLabelX;
160              labelY = curLabelY;
161           end;
162           curCategory = &category;
163           y=0;
164           prevY=0;
165        end;
166        else do;
167           y=nextY;
168           prevY = y;
169           x=prevX;
170        end;
171        output;
172        labelX=.;
173        labelY=.;
174        y = y + &response;
175        nextY = y;
176        output;
177        prevX = x;
178        x = x + &width;
179        output;
180        subLabelX = prevX + ((x-prevX) / 2);
181        subLabelY = prevY + ((y-prevY) / 2);
182        subLabel = &response;
183        curLabelX = prevX + ((x-prevX) / 2);
184        curLabelY = prevY + (y-prevy);
185        y=prevY;
186        output;
187        subLabelX=.;
188        sunLabelY=.;
189        if (_last_) then do;
190           x=.;
191           y=.;
192           label = curCategory;
193           labelX = curLabelX;
