49         /*  Area bar chart with color response                         */
50         /*  notes:                                                     */
51         /*  - The values for the response and width input              */
52         /*    variables are summed.                                    */
53         /*  - The color response is summed by default, but supports    */
54         /*    PROC SUMMARY statistics via the colorStat argument.      */
55         /*  - The response output column contains the                  */
56         /*    response values for labeling.                            */
57         /*  - The width output column contains the width               */
58         /*    values for labeling.                                     */
59         /*                                                             */
60         /*  args:                                                      */
61         /*  input - input data set name                                */
62         /*  output - output data set name                              */
63         /*  category - category variable for each bar                  */
64         /*  response - variable for the length of each bar             */
65         /*  width - variable for the width of each bar                 */
66         /*  colorResp - continuous variable used to represent color    */
67         /*  colorStat (optional) - the SUMMARY statistic for colorResp */
68         /***************************************************************/
69         %macro genAreaBarDataColorResponse(input, output, category, response, width, colorResp, colorStat=sum);
70         proc summary data=&input nway;
71         class &category;
72         var &colorResp;
73         output out=_out_color_ &colorStat=_colorResponse_;
74         run;
75         
76         proc summary data=&input nway;
77         class &category;
78         var &response &width;
79         output out=_out_totals_ sum=;
80         run;
