109        /*  Area bar chart with subgroups                  */
110        /*  notes:                                         */
111        /*  - The values for the response and width        */
112        /*    variables are summed.                        */
113        /*  - Use TEXT plot statements to display the      */
114        /*    subgroup labels and bar labels.              */
115        /*  - The generated subLabel, subLabelX, and       */
116        /*    subLabelY variables can be used to display   */
117        /*    the subgroup values in each segment.         */
118        /*  - The generated label, labelX, and labelY      */
119        /*    variables can be used to display the         */
120        /*    category values above each bar.              */
121        /*                                                 */
122        /*                                                 */
123        /*  args:                                          */
124        /*  input - input data set name                    */
125        /*  output - output data set name                  */
126        /*  category - category variable for each bar      */
127        /*  response - variable for the length of each bar */
128        /*  width - variable for the width of each bar     */
129        /*  subgroup - variable for the bar segments       */
130        /***************************************************/
131        
132        %macro genAreaBarDataSubgroup(input, output, category, response, width, subgroup);
133        proc summary data=&input nway;
134        class &category;
135        var &width;
136        output out=_out_width_ sum=;
137        run;
138        
                                                           The SAS System

139        proc summary data=&input nway;
140        class &category &subgroup;
141        var &response;
142        output out=_out_totals_ sum=;
