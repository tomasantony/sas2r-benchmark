64         prop=compbl(PUT(x,6.)||'/'||put(n,8.)||' ('||Put(PERCENT,6.&Pdec.)||')');
65         CI_95=compbl( '('||put(CI_LOW*100,5.&dec.)||', '||put(CI_HIGH*100,5.&dec.)||')');
66         	format PERCENT CI_LOW CI_HIGH p 5.&dec. ;
