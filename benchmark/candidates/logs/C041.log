434            xc=p[1,1]; yc=p[2,1]; zc=p[3,1]; wc=p[4,1];
435          end;
436        
437          /*--extract data for Code position--*/
438          else if type='Code' then do;
439            xcode=p[1,1]; ycode=p[2,1]; zcode=p[3,1]; wcode=p[4,1];
440          end;
441        
442          /*--extract data for y-axis grid lines--*/
443          else if type='Y-Axis' then do;
444            xAy=p[1,1]; yAy=p[2,1]; zAy=p[3,1]; wAy=p[4,1];
445          end;
446        
447          /*--extract data for y-axis tick values--*/
448          else if type='Y-Values' then do;
449            xYv=p[1,1]; yYv=p[2,1]; zYv=p[3,1]; wYv=p[4,1];
450          end;
451        
452          /*--extract data for z-axis tick values--*/
453          else if type='Z-Values' then do;
454            xZv=p[1,1]; yZv=p[2,1]; zZv=p[3,1]; wZv=p[4,1];
455          end;
456        run;
