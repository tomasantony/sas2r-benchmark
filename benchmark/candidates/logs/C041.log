109        data projected_walls;
110          keep id wgroup xw yw zw xw2 yw2 zw2 xl yl zl lbx lby lbz label;
111          array u[4,4]  _temporary_;  /*--Intermediate Matrix--*/
112          array v[4,4]  _temporary_;  /*--Intermediate Matrix--*/
