119          array p[4,1]  _temporary_;  /*--Projected Data Array --*/
120          retain r t f n;
121          r=1; t=1; f=1; n=-1;
122          pi=constant("PI");
123          fac=pi/180;
124          A=&A*fac; B=&B*fac; C=&C*fac;
125        
126          /*--Set up projection matrix--*/
127          m[1,1]=1/r;   m[1,2]=0.0;  m[1,3]=0.0;      m[1,4]=0.0;
128          m[2,1]=0.0;   m[2,2]=1/t;  m[2,3]=0.0;      m[2,4]=0.0;
129          m[3,1]=0.0;   m[3,2]=0.0;  m[3,3]=-2/(f-n); m[3,4]=-(f+n)/(f-n);
130          m[4,1]=0.0;   m[4,2]=0.0;  m[4,3]=0.0;      m[4,4]=1.0;
131        
132          /*--Set up X rotation matrix--*/
133          rx[1,1]=1;     rx[1,2]=0.0;     rx[1,3]=0.0;      rx[1,4]=0.0;
134          rx[2,1]=0.0;   rx[2,2]=cos(A);  rx[2,3]=-sin(A);  rx[2,4]=0.0;
135          rx[3,1]=0.0;   rx[3,2]=sin(A);  rx[3,3]=cos(A);   rx[3,4]=0.0;
136          rx[4,1]=0.0;   rx[4,2]=0.0;     rx[4,3]=0.0;      rx[4,4]=1.0;
137        
138          /*--Set up Y rotation matrix--*/
