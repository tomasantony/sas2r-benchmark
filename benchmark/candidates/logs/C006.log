90         /* The formulas for standard errors are in Table 3 (p. 246) of
91            Goulet-Pelletiera and Cousineau (2018).
92            https://www.tqmp.org/RegularArticles/vol14-4/p242/p242.pdf
93         
94            The formulas depend on whether you use d or g
95            to estimate the population standardized effect size. The symbol 'delta'
96            is the population effect size, which we estimate by using d or g.
97         
98            Standard error of statistic for standardized effect size:
99            Var     Label               Reference
100           SE      "True SE"           Hedges (1981), p. 111, Eqn. 6b
101           SE_mle  "MLE Approx SE"
102           SE_h    "Hedges' Approx SE"
103        
104           The best estimate of SE is "True SE". */
105        data SEEffectSize;
106        length Statistic $10;
107        keep Statistic Estimate SE SE_mle SE_h delta_lower delta_upper;
108        label Estimate="Estimate" SE="True SE" SE_mle="MLE Approx SE" SE_h="Hedges' Approx SE"
109              delta_lower="Lower 95% CL" delta_upper="Upper 95% CL";
110        set EffectSize;
111        do i = 1 to 2;
112           if i=1 then do;
113              Statistic="Hedges' g"; Estimate = g;    /* g is a better estimate of effect size */
114           end;
115           else do;
116              Statistic="Cohen's d"; Estimate = d;    /* but you can use d, if you want */
117           end;
118        
119           /* the harmonic mean of n1 and n2 is  2*n1*n2/(n1+n2) */
120           delta = Estimate;          /* use either d or g as the estimate */
121           w = 2/harmean(n1,n2);      /* 2/H(n1,n2) = (n1+n2)/(n1*n2) */
122           df = n1 + n2 - 2;          /* degrees of freedom */
123           /* The best estimate of standard error is the "true formula" */
124           var = df/(df-2) * (w + delta**2) - (delta/J)**2;
125           SE = sqrt( var );
126        
127           /* The following formulas are approximations. They are included because some
128              references use them */
129              /* Hedges' Approx SE: Hedges (1981, p. 117) approx for N > 50 */
130              var_h = w + delta**2/(2*df);
131              SE_h   = sqrt( var_h );
132              /* MLE Approx SE: Hedges & Olkin (1985), Eqn.11, p.82.
133                 This is used in the Handbook of Research Synthesis (p. 238)
134                 https://stats.stackexchange.com/questions/8487/how-do-you-calculate-confidence-intervals-for-cohens-d */
135              factor = (df+2)/df;       /* MLE correction factor */
136              SE_mle = sqrt( var_h * factor );
137          /* END approx formula section */
138        
139          /* CIs obtained from noncentral t distribution; this is exact for Hedges' g. */
140          /* The assumptions for the CI are
141              1. the data are sampled independently
142              2. the populations are normal
143              3. groups have the same variance (eg, homogeneity of variance)
144           */
145           lambda = delta / sqrt(w);  /* noncentrality parameter for t distribution (2 indep groups) */
                                                           The SAS System

146           alpha = 0.05;
147           t_lower = quantile("t",   alpha/2, df, lambda);  /* noncentral t,   alpha/2 quantile */
148           t_upper = quantile("t", 1-alpha/2, df, lambda);  /* noncentral t, 1-alpha/2 quantile */
149           /* transform CI for t into CI for delta. Note: This actually reduces to t*sqrt(w) */
150           delta_lower = t_lower / (lambda/delta);          /* LCL for effect size, delta */
151           delta_upper = t_upper / (lambda/delta);          /* UCL for effect size, delta */
152           output;
153        end;
154        run;

