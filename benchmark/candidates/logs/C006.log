59         
60         /* read statisitcs n1,n2,m1,m2,PooledSD; use to form Cohen's d and Hedges' g */
61         data EffectSize;
62         retain n1 m1 n2 m2 PooledSD;
63         keep n1 m1 n2 m2 PooledSD d g J;
64         label d="Cohen's d" g="Hedges' g" J="Hedges' correction factor";
65         set TTestOut end=EOF;
66         if _N_=1 then do;
67            n1 = N; m1 = Mean;
68         end;
69         if _N_=2 then do;
70            n2 = N; m2 = Mean;
71         end;
72         if _N_=3 then
73            PooledSD = StdDev;
74         if EOF then do;
75            /* Cohen's d, which is a biased estimator */
76            d = (m1 - m2) / PooledSD;
77            /* J is Hedge's correction factor. See Cousineau & Goulet-Pelletier (2020, p. 244) */
78            df = n1 + n2 - 2;
79            J =  exp( lgamma(df/2) - lgamma((df-1)/2) - log(sqrt(df/2)) );
80            g = J * d;                  /* Hedge's g, which is an unbiased estimator */
81            output;
82         end;
83         run;

