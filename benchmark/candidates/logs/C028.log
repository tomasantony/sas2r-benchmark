1          /************************************************************************************************
2           SORT ROWS BY GROUPS AND IN DESCENDING ORDER
3               This program sorts by multiple columns in both ascending and descending order.
4               Keywords: PROC SORT
5               SAS Versions: SAS 9, SAS Viya
6               Documentation:
6        ! https://documentation.sas.com/?cdcId=pgmsascdc&cdcVersion=default&docsetId=proc&docsetTarget=p1nd17xr6wof4sn19zkmid81p926
6        ! .htm
7               1. Create the WORK.CLASSTEST table and print it.
8               2. Read CLASSTEST, sort rows by Subject in ascending order, then within Subject by Score
9                  in descending order. The sorted data is saved in a new table, WORK.CLASSTEST_SORT.
10                 Note that the keyword DESCENDING changes the order for the variable it precedes.
11         ************************************************************************************************/
12         
13         data classtest;                                                       /*1*/
14            infile datalines dsd;
15            input
16               Name :$7.
17               Subject :$7.
18               Score;
19         datalines4;

