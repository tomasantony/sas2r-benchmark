1          /* SAS program to accompany the article
2             "Visualize collinearity diagnostics"
3             by Rick Wicklin, published 17FEB2020 on The DO Loop blog:
4             https://blogs.sas.com/content/iml/2020/02/17/visualize-collinearity-diagnostics.html
5          
6             This program shows how to create a heat map that visualizes
7             the collinearity diagnostics that are produced by PROC REG in SAS.
8          
9             Main steps of the program:
10            1. Use
11               ods output CollinDiag = Collin;
12               to save the Collinearity Diagnostics table to a data set.
13            2. Use PROC FORMAT to define a format. The format converts
14               the table values into discrete values:
15               A. The condition indices (which are in the range [1, infinity])
16                  ==> condLow, condMed, condHigh, condExtreme
17               B. The proportion of variance values (which are in the range [0, 1))
18                  ==> propLow, propMed, propHigh
19            3. Convert the data set from wide form to long form.
20            4. Create a discrete attribute map that maps categories to colors.
21            5. Create a discrete heat map that visualizes the collinearity
22               diagnostics. Overlay (rounded) values for the condition indices
                                                           The SAS System

23               and the important (relatively large) values of the proportion of variance.
24         
25            Data from the PROC REG documentation.
26         */
27         ods graphics/reset;
28         
29         data fitness;
30            input Age Weight Oxygen RunTime RestPulse RunPulse MaxPulse @@;
31            datalines;

