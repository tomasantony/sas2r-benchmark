127        ;
128        
129        /* Create a discrete heat map and overlay text for the condition numbers
130           and the important (high) cells of the proportion of variance. */
131        title "Collinearity Diagnostics";
132        proc sgplot data=CollinLong dattrmap=Order noautolegend;
133          format Val CollinFmt.;
134          heatmapparm x=VarName y=Number colorgroup=Val / outline
135                      attrid=SortOrder nomissingcolor discretey;
136          text x=VarName y=Number text=TextVal / strip textattrs=(size=14);
137          refline "ConditionIndex" / axis=x lineattrs=(color=DarkGray)
138                  discreteoffset=0.5 discretethickness=0.08;
