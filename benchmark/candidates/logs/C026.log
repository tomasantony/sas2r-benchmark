50         /* Run regression collinearity diagnostics:
51            https://blogs.sas.com/content/iml/2020/01/23/collinearity-regression-collin-option.html
52         */
53         proc reg data=fitness plots=none;
54            model Oxygen = RunTime Age Weight RunPulse MaxPulse RestPulse / collin;
55            ods select ParameterEstimates CollinDiag;
56            ods output CollinDiag = Collin;
