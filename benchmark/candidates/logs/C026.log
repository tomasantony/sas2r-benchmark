110        /* create a discrete attribute map:
111           https://blogs.sas.com/content/iml/2019/07/15/create-discrete-heat-map-sgplot.html
112        */
113        data Order;                            /* create discrete attribute map */
114        length Value $15 FillColor $15;
115        input raw FillColor;
116        Value = put(raw, CollinFmt.);          /* use format to assign values */
117        retain ID 'SortOrder'                  /* name of map */
118             Show 'AttrMap';                   /* always show all groups in legend */
119        datalines;

