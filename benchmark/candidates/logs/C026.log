81         /* Convert from wide to long for graphing:
82            https://blogs.sas.com/content/iml/2019/06/03/graph-wide-data-long-data-sas-sgplot.html
83            The variables in the long data set are:
84            Number  : The original row number
85            VarName : The name of the original (wide) variables
86            Val     : The numerical value of VarName for the row
87            TextVal : A string value to be overlaid on the heat map.
88                    : For the condition index, use a 5.0 format
89                    : For the proportions of variance, use
90                    : a blank if Val < 0.4, otherwise use the
91                    : percentage round(100*Val)
92         */
93         data CollinLong;
94         length VarName $32 TextVal $5;
95         set collin(drop=Model Dependent Eigenvalue);
96         array v[*] _numeric_;
97         do j = 2 to dim(v);
98            VarName = vname(v[j]);
99            Val = v[j];
100           if j=2 then TextVal = put(Val, 5.0);
101           else do;
102              if Val<0.4 then TextVal = ' ';
103              else TextVal = put(100*Val, 2.0); *convert proportion to pct;
104           end;
105           output;
106        end;
107        keep Number VarName Val TextVal;
108        run;

