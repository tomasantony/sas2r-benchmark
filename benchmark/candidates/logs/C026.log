59         /* convert variable ranges into strings for the discrete heat map.
60            For proportions, the ranges are determined by the cut points
61            [0.0, 0.4) white
62            [0.4, 0.5) pink
63            [0.5, 1)   red
64            For condition indices, the ranges are determined by the cut points
65            [1, 20)    green
66            [20, 30)   yellow
67            [30, 100)  orange
68            [100, infinity) red
69         */
70         proc format;
                                                           The SAS System

71         value CollinFmt
72           0.0 -<  0.4  = "PropLow"
73           0.4 -<  0.5  = "PropMed"
74           0.5 -<  1.0  = "PropHigh"
75           1.0 -<  20   = "CondLow"
76            20 -<  30   = "CondMed"
77            30 -< 100   = "CondHigh"
78            other       = "CondExtreme";
NOTE: Format COLLINFMT has been output.
