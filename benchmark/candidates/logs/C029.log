14         /*--Create some data--*/
15         data tumor;
16           label dropped='Discontinued' Duration='Treatment Duration';
17           format Drug res.;
18           length Code $6;
19           do i=1 to 20;
20             Response=100*(ranuni(3)-0.7);
21             Duration=50*ranuni(3);
22         	Dropped=.;
23             if ranuni(3) > 0.6 then Dropped=duration-5;
24         	Drug=floor(6*ranuni(3));
25         	if ranuni(3) > 0.7 then Code='FL';
26         	else Code='DLBCL';
27         	codeloc=ifn(response > 0, 0, response);
28         	baseline=20+180*(ranuni(2));
29             output;
30           end;
31         run;

