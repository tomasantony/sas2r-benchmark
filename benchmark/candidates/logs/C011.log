1          /* SAS program to accompany the article
2             "Fit, simulate, fit: How models can collapse after generations of recursive fitting"
3             by Rick Wicklin, published 31JUL2024 on The DO Loop blog:
4              https://blogs.sas.com/content/iml/2024/07/31/synthetic-data-model-collapse.html
5          
6             This program shows that models trained recursively from synthetic data
7             can experience parameter drift and model collapse, which is a decrease in the
8             variance of the model.
9          
10            The programs are intended to illustrate the ideas related to
11            model collapse in synthetic text generation:
12            Gibney, 2024, "AI models fed AI-generated data quickly spew nonsense"
13                https://www.nature.com/articles/d41586-024-02420-7
14            which reports are the article by
15            Shumailov, I., Shumaylov, Z., Zhao, Y. et al. (2024)
16                "AI models collapse when trained on recursively generated data,"
17                Nature 631, 755Ã¢â‚¬â€œ759.
18                https://doi.org/10.1038/s41586-024-07566-y
19         */
20         
21         /* clear macros and set define some useful macros from
22            https://blogs.sas.com/content/iml/2013/05/24/turn-off-ods-for-simulations.html
                                                           The SAS System

23         */
24         %symdel N / nowarn;
25         %symdel SeedVal / nowarn;
26         %macro ODSOff(); /* Call prior to macro loop */
27         ods graphics off;
28         ods exclude all;
29         ods noresults;
30         options nonotes;
31         %mend;
32         
33         %macro ODSOn(); /* Call after BY-group processing */
34         ods graphics on;
35         ods exclude none;
36         ods results;
37         options notes;
38         %mend;
39         
40         /***************************/
41         /* Start with normally distributed data.
42            At each generation, fit a model to the data, then simulate
43            more data from the model. Repeat many times.
44            The following simulations take about 30-45 seconds to complete.
45         */
46         %let N = 200;
47         %let SeedVal = 123;
48         
49         %let mu0 = 125;
50         %let sigma0 = 30;
51         data Param0;
52         mu = &mu0;
53         sigma = &sigma0;
54         run;

