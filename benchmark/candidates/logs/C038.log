35         /*--Create some data--*/
36         data tumor;
37           format Drug res.;
38           length Code $6;
39           do i=1 to 20;
40             Response=100*(ranuni(3)-0.7);
41             Duration=50*ranuni(3);
42         	Dropped=.;
43             if ranuni(3) > 0.8 then Dropped=duration-5;
44         	Drug=floor(6*ranuni(3));
45         	if ranuni(3) > 0.7 then Code='FL';
46         	else Code='DLBCL';
47         	codeloc=ifn(response > 0, 0, response);
48         	baseline=20+180*(ranuni(2));
49             output;
50           end;
51         run;

