/* pipeline driver for family own-adam: each program builds its ADaM dataset in WORK from inline data; copy it to outds, then clear WORK */
%let family = own-adam;
proc printto log="&outlog./P083.log" print="&outlog./P083.lst" new; run;
%let pid = P083; %let outds = &root./output/sas/datasets/P083; libname outds "&outds.";
%put NOTE: ===== pipeline own-adam: P083 P083_adsl.sas =====;
%include "&root./programs/sas_run/P083_adsl.sas";
proc datasets lib=work nolist; copy out=outds memtype=data; select ad:; run; quit; proc datasets lib=work kill nolist; run; quit;
proc printto; run;
