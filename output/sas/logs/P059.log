64         
65         data adpp_sum_t; * adpp_sum transposed;
66           set adpp_sum;
67           length value $ 30.;
68           by ANLPRNT PPSPECL PPCATL;
69           s_order = 1; * n;
70           value = put(n1, 2.);
71           output;
72           s_order = 2; * mean (sd);
73           select;
74             when(index(_PARAM,'AUC')>0)  value = put(mn1,6.) ||' ('||put(std1,5.) ||')';
75             when(index(_PARAM,'Cmax')>0) value = put(mn1,5.) ||' ('||put(std1,4.) ||')';
76             when(index(_PARAM,'MRT')>0)  value = put(mn1,4.1)||' ('||put(std1,4.2)||')';
77             when(index(_PARAM,'t1/2')>0) value = put(mn1,4.2)||' ('||put(std1,4.2)||')';
78         	otherwise value = ' ';
79           end;
80           output;
81           s_order = 3; * CV% mean;
82           if index(_PARAM,'tmax')=0 then value = put(cv1,4.1);
83           else value = ' ';
84           output;
85           s_order = 4; * geo-mean;
86           select;
87             when(index(_PARAM,'AUC')>0)  value = put(exp(mn2),6.);
88             when(index(_PARAM,'Cmax')>0) value = put(exp(mn2),5.);
89             when(index(_PARAM,'MRT')>0)  value = put(exp(mn2),4.1);
90             when(index(_PARAM,'t1/2')>0) value = put(exp(mn2),4.2);
91         	otherwise value = ' ';
92           end;
93           output;
94           s_order = 5; * CV% geo-mean;
95           if index(_PARAM,'tmax')=0 then value = put(sqrt(exp(std2**2)-1)*100,4.1);
96           else value = ' ';
97           output;
98           s_order = 6; * median;
99           select;
100            when(index(_PARAM,'AUC')>0)  value = put(med1,6.);
101            when(index(_PARAM,'Cmax')>0) value = put(med1,5.);
102            when(index(_PARAM,'MRT')>0)  value = put(med1,4.1);
103            when(index(_PARAM,'t1/2')>0) value = put(med1,4.2);
104            when(index(_PARAM,'tmax')>0) value = put(med1,4.2);
105        	otherwise;
106          end;
107          output;
108          s_order = 7; /* [min; max] */;
109          select;
110            when(index(_PARAM,'AUC')>0)  value = '['||put(min1,6.) ||';'||put(max1,6.) ||']';
111            when(index(_PARAM,'Cmax')>0) value = '['||put(min1,4.) ||';'||put(max1,5.) ||']';
