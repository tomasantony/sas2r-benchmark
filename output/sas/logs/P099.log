1          /* SAS program to accompany the article
2             "How to read a cumulative frequency graph"
                                                           The SAS System

3             by Rick Wicklin, published 25MAR2020 on The DO Loop blog:
4             https://blogs.sas.com/content/iml/2020/03/25/read-cumulative-frequency-graph.html
5          
6             This program shows how to visualize cumulative curve and deduce the rate
7             of the underlying new cases.
8          */
9          data Demo;
10         call streaminit(123);
11         do Day = 1 to 100;
12            if Day < 35 then do;
13                Block = "Concave Up:/New Cases/Increasing  ";
14                NewCases = Day + rand("Normal");
15            end;
16            else if Day < 68 then DO;
17                /* use non-breaking space, copied from Windows Character Map */
18                Block = "Linear:/New Cases/Constant        ";
19                NewCases = 30 + mod(Day,2);
20            end;
21            else do;
22                Block = "Concave Down:/New Cases/Decreasing";
23                NewCases = 100 - Day + rand("Normal");
24            end;
25            NewCases = floor(0.49*NewCases);
26            if NewCases < 0 then NewCases = 0;
27            Cumul + NewCases;
28            output;
29         end;
30         
31         title "Cumulative Cases versus Time";

