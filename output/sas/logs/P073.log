603        /*--- Step 4: Duration categories ---*/
604        data dur_cat;
605            set ex_adsl;
606            length DURCAT $30;
607        
608            if      TRTDUR = . then DURCAT = 'Missing';
609            else if TRTDUR <= 28 then DURCAT = '<=28 days';
610            else if TRTDUR <= 84 then DURCAT = '>28 to <=84 days';
611            else if TRTDUR <= 168 then DURCAT = '>84 to <=168 days';
612            else if TRTDUR <= 336 then DURCAT = '>168 to <=336 days';
613            else DURCAT = '>336 days';
614        
615            /* Order */
616            select(DURCAT);
617                when('<=28 days')           DURCATN = 1;
618                when('>28 to <=84 days')    DURCATN = 2;
619                when('>84 to <=168 days')   DURCATN = 3;
620                when('>168 to <=336 days')  DURCATN = 4;
621                when('>336 days')           DURCATN = 5;
622                when('Missing')             DURCATN = 6;
623                otherwise                   DURCATN = 99;
624            end;
625        run;

