3          Macro name:    diagram_plot
4            Purpose:
5              Combines all generated diagram components (boxes, text,
6              and lines) and plots them as a flow diagram using PROC SGPLOT.
7              The macro collects all datasets prefixed with "diagram_" and
8              produces a complete diagram without axes or borders.
9          
10           Parameters:
11             minx  = Minimum value of the X-axis (default=0)
12             maxx  = Maximum value of the X-axis (default=100)
13             miny  = Minimum value of the Y-axis (default=0)
14             maxy  = Maximum value of the Y-axis (default=100)
15             text_font = Text font (default=Courier)
16         
17           Notes:
18             - This macro expects that %diagram_box and %diagram_line
19               have already been called to create the component datasets.
20             - Text is automatically split by the SPLITCHAR (#) option.
21             - Arrows are drawn for lines with arrowhead at the end.
22         
23           Usage Example:
24             %diagram_box(
25                 boxid=1,
26                 left_x=30, top_y=100,
27                 right_x=70, bottom_y=90,
28                 text=Assessed for eligibility (n=100)
29             );
30         
31             %diagram_line(
32                 lineid=1,
33                 start_x=50, start_y=90,
34                 end_x=50,   end_y=55
35             );
36         
37             %diagram_box(
38                 boxid=2,
39                 left_x=37, top_y=55,
40                 right_x=63, bottom_y=45,
41                 text=Randomized (n=90)
42             );
43         
44             %diagram_plot(minx=0, maxx=100, miny=0, maxy=100);
45         
46         *//*** HELP END ***/
47         
48         %macro diagram_plot(minx=0,maxx=100,miny=0,maxy=100,text_font=Courier);
49         data plot_diag;
50         length text text2 $1000.;
51         set diagram_:;
52         run;
53         
54         data plot_diag_attr;
55         set diag_style_: line_style_:;
56         run;
57         
58         proc sgplot data=plot_diag noborder noautolegend dattrmap=plot_diag_attr;
59           polygon id=boxid x=box_x y=box_y/attrid=DIAGID group=DIAGID;
60           text x=text_x y=text_y text=text /textattrs=(family="&text_font") attrid=DIAGID group=DIAGID sizemin=1pt
                                                           The SAS System

60       ! sizemaxresponse=100 sizemax=100pt sizeresponse = sizeresponse  splitchar='#' splitpolicy=splitalways;
61           text x=text_x2 y=text_y2 text=text2 /textattrs=(family="&text_font") attrid=DIAGID group=DIAGID  sizemin=1pt
61       ! sizemaxresponse=100 sizemax=100pt sizeresponse = sizeresponse  sizeresponse = sizeresponse  position=right splitchar='#'
61       ! splitpolicy=splitalways;
62           series x=line_x y=line_y/ attrid=_LINEID  group=_LINEID  arrowheadshape=filled arrowheadpos=end  arrowheadscale=0.3;
63         
64           xaxis display=none min=&minx. max=&maxx. offsetmin=0 offsetmax=0;
65           yaxis display=none min=&miny. max=&maxy. offsetmin=0 offsetmax=0;
66         run;
67         %mend;
68         
