363            demog = catx('/', strip(put(AGE, best.)), strip(SEX), strip(substr(RACE, 1, 1)));
364        
365            if DAYS_LASTDOSE_DEATH ne . then
366                days_display = strip(put(DAYS_LASTDOSE_DEATH, 8.));
367            else days_display = 'N/A';
368        run;

