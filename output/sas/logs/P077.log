313        /*--- Step 1: Identify deaths ---*/
314        proc sql noprint;
315            create table deaths as
316            select a.USUBJID,
317                   a.TRTA, a.AGE, a.SEX, a.RACE,
318                   a.TRTSDT format=date9. as TRT_START,
319                   a.TRTEDT format=date9. as TRT_END,
320                   a.DTHDT format=date9. as DEATH_DATE,
321                   a.DTHCAUS as CAUSE_OF_DEATH,
322                   /* Days from last dose to death */
323                   case when a.DTHDT ne . and a.TRTEDT ne .
324                        then a.DTHDT - a.TRTEDT
325                        else .
326                   end as DAYS_LASTDOSE_DEATH,
327                   /* Days from first dose to death */
328                   case when a.DTHDT ne . and a.TRTSDT ne .
329                        then a.DTHDT - a.TRTSDT + 1
330                        else .
331                   end as DAYS_FIRSTDOSE_DEATH
332            from adam.adsl a
333            where a.DTHFL = 'Y'
334            order by a.TRTA, a.USUBJID;
