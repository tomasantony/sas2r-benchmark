349        proc sql noprint;
350            create table death_report as
351            select a.*,
352                   b.FATAL_AE_SOC, b.FATAL_AE_PT, b.FATAL_AE_REL
353            from deaths a
354            left join death_ae b on a.USUBJID = b.USUBJID
355            order by a.TRTA, a.USUBJID;
