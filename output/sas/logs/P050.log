66         * Parameters:							;
67         * OUTDATA - output dataset name         ;
68         * WHERE - for subset the input dataset  ;
69         %macro disp(outdata=, where=, var=);
70         	proc sql;
71         		create table &outdata as
72         			select count(distinct usubjid) as cnt, (calculated cnt*100)/tot as per, &var as col1, a.trt01an, trt01a length=50
73         				from adsl1 as a, tot as b
74         					where &where and a.trt01an = b.trt01an
75         						group by a.trt01an, trt01a, tot, col1;
76         	quit;
77         %mend disp;
