272        /*--- Step 2: Assign display order (sorted by percent change) ---*/
273        data waterfall;
274            set tumor;
275            by PCHG;
276            bar_order = _n_;
277        
278            /* Color by response category */
279            length bar_color $20;
280            select(upcase(AVALC));
281                when('CR') bar_color = 'darkgreen';
282                when('PR') bar_color = 'green';
283                when('SD') bar_color = 'gold';
284                when('PD') bar_color = 'red';
285                otherwise  bar_color = 'gray';
286            end;
287        
288            /* Cap at reasonable bounds */
289            if PCHG > 100 then PCHG_display = 100;
290            else if PCHG < -100 then PCHG_display = -100;
291            else PCHG_display = PCHG;
292        run;

