242        
243        /*--- Step 1: Get best percentage change per subject ---*/
244        proc sql noprint;
245            create table tumor as
246            select a.USUBJID, a.TRTA, a.TRTAN,
247                   a.PARAMCD, a.PARAM,
248                   a.PCHG,        /* Percent change from baseline */
249                   a.AVALC,       /* Best overall response category */
250                   b.EFFFL
251            from adam.adtr a      /* Tumor response dataset */
252            inner join adam.adsl b on a.USUBJID = b.USUBJID
253            where b.EFFFL = 'Y'
254                  and a.PARAMCD = 'BPCHG'  /* Best percent change */
255            order by a.PCHG;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.TUMOR created, with 222 rows and 8 columns.

256        quit;
