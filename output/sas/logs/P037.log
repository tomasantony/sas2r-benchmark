92         * Compute Fisher Exact p-value;
93         %macro fisherpval(flg=, tefl=);
94         proc sort data=advs;
95         	by usubjid &flg;
96         run;
97         
98         data &flg;
99         	set advs;
100        	by usubjid &flg;
101        	if last.usubjid;
102        run;
103        
104        ods output FishersExact=fisher_&flg;
105        proc freq data = &flg;
106        	tables param*trtpn*&flg/fisher;
107        run;
108        
109        data fisher_&flg;
110        	set fisher_&flg;
111        	length tefl $4.;
112        	tefl="&tefl";
113        	where name1="XP2_FISH";
114        	keep tefl nvalue1;
115        run;
116        %mend;
