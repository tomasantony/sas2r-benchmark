411        /*--- Step 2: Derive baseline and worst post-baseline grades ---*/
412        proc sql noprint;
413            create table lb as
414            select a.USUBJID, a.TRTA, a.TRTAN, a.PARAMCD, a.PARAM,
415                   a.AVISIT, a.AVISITN,
416                   a.ATOXGR,     /* Toxicity grade */
417                   a.BTOXGR,     /* Baseline toxicity grade */
418                   a.ABLFL, a.ANL01FL
419            from adam.adlb a
420            inner join adam.adsl b on a.USUBJID = b.USUBJID
421            where b.SAFFL = 'Y'
422                  and a.PARAMCD in ('ALT', 'AST', 'BILI', 'CREAT', 'HGB', 'WBC', 'PLAT', 'NEUT')
423            order by a.TRTAN, a.PARAMCD, a.USUBJID, a.AVISITN;
