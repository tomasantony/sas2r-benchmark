515        
516        data report;
517            length bl_label $20;
518            set shift_t;
519        
520            /* Label baseline grades */
521            select(bl_grade);
522                when('0') bl_label = 'Normal';
523                when('1') bl_label = 'Grade 1';
524                when('2') bl_label = 'Grade 2';
525                when('3') bl_label = 'Grade 3';
526                when('4') bl_label = 'Grade 4';
527                otherwise bl_label = bl_grade;
528            end;
529        
530            /* Replace missing with 0 */
531            array wgs{*} wg:;
532            do i = 1 to dim(wgs);
533                if wgs{i} = . then wgs{i} = 0;
534            end;
535        
536            /* Row total */
537            total = sum(of wg:);
538            drop i;
539        run;

