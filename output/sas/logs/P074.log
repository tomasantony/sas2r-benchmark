452        /*--- Step 5: Merge baseline and worst post-baseline ---*/
453        proc sql noprint;
454            create table shift as
455            select a.*, b.worst_grade
456            from bl_grade a
457            inner join worst_grade2 b
458            on a.USUBJID = b.USUBJID
459               and a.PARAMCD = b.PARAMCD
460               and a.TRTA = b.TRTA
461            order by a.TRTAN, a.PARAMCD, a.bl_grade, b.worst_grade;
