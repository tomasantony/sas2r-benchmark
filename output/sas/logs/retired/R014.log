269        
270            %macro boxplot_each_param_tp(plotds=css_anadata, cleanup=1);
271        
272              %local pdx tdx ;
273        
274              %do pdx = 1 %to &paramcd_n;
275        
276                /*** LOOP 1 *****************************************************
277                 *** Loop through each PARAMETER, working with ALL TIMEPOINTS ***
278                 ****************************************************************/
279                  data css_nextparam;
280                    set &plotds (where=(paramcd = "&&paramcd_val&pdx"));
281                  run;
282        
283                %*--- Analysis Timepoints for this parameter: Num (&ATPTN_N), Names (&ATPTN_VAL1 ...) and Labels (&ATPTN_LAB1 ...) ---*;
284                  %util_labels_from_var(css_nextparam, atptn, atpt)
285        
286                %*--- Create NXT_REFLINES: a list of reference lines for this parameter, across all timepoints ---*;
287                  %util_get_reference_lines(css_nextparam, nxt_reflines,
288                                            low_var=&lo_var, high_var=&hi_var, ref_lines=&ref_lines)
289        
290                %*--- Y-AXIS alternative: Fix Y-Axis MIN/MAX based on all timepoints for PARAM. See Y-AXIS DEFAULT, below. ---*;
291                %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                                    ---*;
292                %*   %util_get_var_min_max(css_nextparam, &m_var, aval_min_max, extra=&nxt_reflines)   *;
293        
294        
295                %do tdx = 1 %to &atptn_n;
296        
297                  /*** LOOP 2 ********************************************************************
298                   *** Loop through each TIMEPOINT for this parameter, working with ALL VISITS ***
299                   *** NB: PROC SORT here is REQUIRED in order to merge on STAT details, below ***
300                   *******************************************************************************/
301                    proc sort data=css_nextparam (where=(atptn = &&atptn_val&tdx))
302                               out=css_nexttimept;
303                      by avisitn &tn_var;
304                    run;
305        
306                  %*--- Y-AXIS DEFAULT: Set Y-Axis MIN/MAX based on this timepoint. See Y-AXIS alternative, above. ---*;
307                  %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                          ---*;
308                    %util_get_var_min_max(css_nexttimept, &m_var, aval_min_max, extra=&nxt_reflines)
309        
310                  %*--- Number of visits for this parameter and analysis timepoint: &VISN ---*;
311                    %util_count_unique_values(css_nexttimept, avisitn, visn)
312        
313                  %*--- Create format string to display MEAN and STDDEV to default sig-digs: &UTIL_VALUE_FORMAT ---*;
314                    %util_value_format(css_nexttimept, &m_var)
315        
316                  %*--- Create macro variable BOXPLOT_BLOCK_RANGES, to subset visits into box plot pages ---*;
317                    %util_boxplot_block_ranges(css_nexttimept, blockvar=avisitn, catvars=&tn_var);
318        
319        
320                  *--- Calculate summary statistics, KEEP LABELS of VISIT and TRT for plotting, below ---*;
321                    proc summary data=css_nexttimept noprint;
322                      by avisitn &tn_var avisit &t_var;
323                      var &m_var;
324                      output out=css_stats (drop=_type_ _freq_)
325                             n=n mean=mean std=std median=median min=datamin max=datamax q1=q1 q3=q3;
326                    run;
327        
328                    /***
329                      STACK statistics (do NOT merge) BELOW the plot data, one obs per TREATMENT/VISIT.
330                      NB: We need exactly ONE obs per timepoint and trt: AXISTABLE defaults to a SUM function
331                    ***/
332                    data css_plot;
333                      set css_nexttimept
334                          css_stats;
335        
336                      format mean %scan(&util_value_format, 1, %str( )) std %scan(&util_value_format, 2, %str( ));
337                    run;
338        
339        
340                  *--- Graphics Settings - Set defaults for all graphs ---*;
341                    options orientation=landscape;
342                    goptions reset=all;
343        
344                    ods graphics on / reset=all;
345                    ods graphics    / border=no attrpriority=COLOR;
346        
347                    title     justify=left height=1.2 "Box Plot - &&paramcd_lab&pdx Observed Values by Visit, Analysis Timepoint: &&atptn_lab&tdx";
348        
349        
350                    footnote1 justify=left height=1.0 'Box plot type is schematic: the box shows median and interquartile range (IQR, the box height); the whiskers extend to the minimum';
351                    footnote2 justify=left height=1.0 'and maximum data points within 1.5 IQR of the lower and upper quartiles, respectively. Values outside the whiskers are shown as outliers.';
352                    footnote3 justify=left height=1.0 'Means are marked with a different symbol for each treatment. Red dots indicate measures outside the normal reference range.';
353        
354                    %let y_axis = %util_axis_order( %scan(&aval_min_max,1,%str( )), %scan(&aval_min_max,2,%str( )) );
355        
356                  *--- ODS PDF destination (Traditional Graphics, No ODS or Listing output) ---*;
357                    ods listing close;
358                    ods pdf file="&outputs_folder/WPCT-F.07.01_Box_plot_&&paramcd_val&pdx.._by_visit_for_timepoint_&&atptn_val&tdx...pdf"
359                            notoc bookmarklist=none dpi=300
360                            author="(&SYSUSERID) PhUSE CS Standard Analysis Library"
361                            subject='PhUSE CS Measures of Central Tendency'
362                            title="Boxplot of &&paramcd_lab&pdx by Visit for Analysis Timepoint &&atptn_lab&tdx"
363                            ;
364        
365        
366                  /*** LOOP 3 - FINALLY, A Graph ****************************
367                   *** - Multiple pages in case of many visits/treatments ***
368                   **********************************************************/
369        
370                    %local vdx nxtvis;
371                    %let vdx=1;
372                    %do %while (%qscan(&boxplot_block_ranges,&vdx,|) ne );
373                      %let nxtvis = %qscan(&boxplot_block_ranges,&vdx,|);
374        
375                      proc sgrender data=css_plot (where=( %unquote(&nxtvis) )) template=PhUSEboxplot ;
376                        dynamic
377                                _MARKERS    = "&t_var"
378                                _XVAR       = 'avisitn'
379                                _BLOCKLABEL = 'avisit'
380                                _YVAR       = "&m_var"
381                                _YOUTLIERS  = 'm_var_outlier'
382        
383                                %if %length(&nxt_reflines) > 0 %then %do;
384                                  _REFLINES   = "%sysfunc(translate( &nxt_reflines, %str(,), %str( ) ))"
385                                %end;
386        
387                                _YLABEL     = "&&paramcd_lab&pdx"
388                                _YMIN       = %scan(&y_axis, 1, %str( ))
389                                _YMAX       = %scan(&y_axis, 3, %str( ))
390                                _YINCR      = %scan(&y_axis, 5, %str( ))
391                                _N          = 'n'
392                                _MEAN       = 'mean'
393                                _STD        = 'std'
394                                _DATAMIN    = 'datamin'
395                                _Q1         = 'q1'
396                                _MEDIAN     = 'median'
397                                _Q3         = 'q3'
398                                _DATAMAX    = 'datamax'
399                                ;
400                      run;
401        
402                      %let vdx=%eval(&vdx+1);
403                    %end; %* --- LOOP 3 - Pages of box plots, VDX ---*;
404        
405                  *--- Release the PDF output file! ---*;
406                    ods pdf close;
407                    ods listing;
408        
409                %end; %*--- LOOP 2 - Time Points, TDX ---*;
410        
411              %end; %*--- LOOP 1 - Parameters, PDX ---*;
412        
413        
414              *--- Clean up temp data sets required to create box plots ---*;
415                %if &cleanup %then %util_delete_dsets(css_nextparam css_nexttimept css_stats css_plot);
416        
417            %mend boxplot_each_param_tp;
418        
419            %boxplot_each_param_tp;
MPRINT(BOXPLOT_EACH_PARAM_TP):   *--- Clean up temp data sets required to create box plots ---*;
