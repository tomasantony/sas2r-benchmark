279                  %util_get_reference_lines(css_nextparam, nxt_reflines,
280                                            low_var=&lo_var, high_var=&hi_var, ref_lines=&ref_lines)
281        
282                %*--- Y-AXIS alternative: Fix Y-Axis MIN/MAX based on all timepoints for PARAM. See Y-AXIS DEFAULT, below. ---*;
283                %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                                    ---*;
284                %*   %util_get_var_min_max(css_nextparam, &m_var, aval_min_max, extra=&nxt_reflines)   *;
285                %*   %util_get_var_min_max(css_nextparam, &c_var, chg_min_max)   *;
286        
287        
288                %do tdx = 1 %to &atptn_n;
289        
290                  /*** LOOP 2 ********************************************************************
291                   *** Loop through each TIMEPOINT for this parameter, working with ALL VISITS ***
292                   *** NB: PROC SORT here is REQUIRED in order to merge on STAT details, below ***
293                   *******************************************************************************/
294                    proc sort data=css_nextparam (where=(atptn = &&atptn_val&tdx))
295                               out=css_nexttimept;
296                      by avisitn &tn_var;
297                    run;
298        
299                  %*--- Y-AXIS DEFAULT: Set Y-Axis MIN/MAX based on this timepoint. See Y-AXIS alternative, above. ---*;
300                  %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                          ---*;
301                    %util_get_var_min_max(css_nexttimept, &m_var, aval_min_max, extra=&nxt_reflines)
302                    %util_get_var_min_max(css_nexttimept, &c_var, chg_min_max)
303        
304                  %*--- Create format string to display MEAN and STDDEV to default sig-digs: &UTIL_VALUE_FORMAT for measures, &CHG_VALUE_FORMAT for change ---*;
305                    %util_value_format(css_nexttimept, &m_var, sym=util_value_format)
306                    %util_value_format(css_nexttimept, &c_var, sym=chg_value_format)
307        
308                  %*--- Create macro variable BOXPLOT_BLOCK_RANGES, to subset visits into box plot pages ---*;
309                    %util_boxplot_block_ranges(css_nexttimept, blockvar=avisitn, catvars=&tn_var);
310        
311        
312                  *--- Calculate summary statistics for VALUEs and CHANGE. KEEP LABELS of VISIT and TRT for plotting, below ---*;
313                    proc summary data=css_nexttimept noprint;
314                      by avisitn &tn_var avisit &t_var;
315                      var &m_var;
316                      output out=css_stats (drop=_type_ _freq_)
317                             n=n mean=mean std=std median=median min=datamin max=datamax q1=q1 q3=q3;
318                    run;
319        
320                    proc summary data=css_nexttimept noprint;
321                      by avisitn &tn_var avisit &t_var;
322                      var &c_var;
323                      output out=css_c_stats (drop=_type_ _freq_)
324                             n=c_n mean=c_mean std=c_std median=c_median min=c_datamin max=c_datamax q1=c_q1 q3=c_q3;
325                    run;
326        
327        
328                  %*--- Add ANCOVA p-values for Endpoint: CHG = BASE + TRT (if user specified a reference arm) ---*;
329                    %if %length(&b_var) > 0 and %length(&ref_trtn) > 0 %then %do;
330                      %local endpoint_definition;
331        
332                      %let css_pval_ds = css_pvalues;
333                      %let endpoint_definition = avisitn = &ep_visn;
334        
335                      ods select parameterestimates;
336                      ods output parameterestimates = &css_pval_ds;
337        
338                      proc glm data=css_nexttimept;
339                        where &endpoint_definition;
340                        class &tn_var (ref="&ref_trtn");
341                        model &c_var = &b_var &tn_var / solution;
342                      run; quit;
343        
344                      *--- UPDATE CSS_STATS with p-values for active arms, at Endpoint visit ---*;
345                        data temp;
346                          *--- We simply need the structure of these vars, for subsequent merge ---*;
347                          set css_stats (keep=avisitn &tn_var);
348                          STOP;
349                        run;
350        
351                        data &css_pval_ds;
352                          set temp &css_pval_ds (keep=parameter probt
353                                                 rename=(probt=pval)
354                                                 where=(parameter=:"%upcase(&tn_var)"));
355                          label pval="GLM ANCOVA p-value: Reference is %upcase(&tn_var) = &ref_trtn";
356                          &endpoint_definition;
357                          &tn_var = input(scan(parameter,-1,' '), best8.);
358                        run;
359        
360                        proc sort data=&css_pval_ds;
361                          by avisitn &tn_var;
362                        run;
363        
364                        data css_stats;
365                          merge css_stats &css_pval_ds (keep=avisitn &tn_var pval);
366                          by avisitn &tn_var;
367                        run;
368        
369                        %util_delete_dsets(temp);
370                    %end;
371        
372        
373                    /***
374                      STACK statistics (do NOT merge) BELOW the plot data, one obs per TREATMENT/VISIT.
375                      NB: We need exactly ONE obs per timepoint and trt: AXISTABLE defaults to a SUM function
376                    ***/
377                    data css_plot;
378                      set css_nexttimept
379                          css_stats
380                          css_c_stats;
381        
382                      format mean %scan(&util_value_format, 1, %str( )) std %scan(&util_value_format, 2, %str( ));
383                      format c_mean %scan(&chg_value_format, 1, %str( )) c_std %scan(&chg_value_format, 2, %str( ));
384                    run;
385        
386        
387                  *--- Graphics Adjustments - Set defaults for all graphs, MISSING=' ' since most P-VALUEs are missing ---*;
388                    options orientation=landscape missing=' ';
389                    goptions reset=all;
390        
391                    ods graphics on / reset=all;
392                    ods graphics    / border=no attrpriority=COLOR;
393        
394                    title1    justify=left height=1.2 "Box Plot - &&paramcd_lab&pdx Observed Values and Change from %upcase(&B_VISN_LAB1) to %upcase(&EP_VISN_LAB1) by Visit";
395                    title2    justify=left height=1.2 "Analysis Timepoint: &&atptn_lab&tdx";
396                    footnote1 justify=left height=1.0 'Box plot type is schematic: the box shows median and interquartile range (IQR, the box height); the whiskers extend to the minimum and maximum data points';
397                    footnote2 justify=left height=1.0 'within 1.5 IQR of the lower and upper quartiles, respectively. Values outside the whiskers are shown as outliers. Means are marked with a different symbol for each treatment.';
398                    footnote3 justify=left height=1.0 'Red dots indicate measures outside the normal reference range. P-value is for the treatment comparison from ANCOVA model Change = Baseline + Treatment.';
399        
400                    %let aval_axis = %util_axis_order( %scan(&aval_min_max,1,%str( )), %scan(&aval_min_max,2,%str( )) );
401                    %let chg_axis  = %util_axis_order( %scan(&chg_min_max,1, %str( )), %scan(&chg_min_max,2, %str( )) );
402        
403                  *--- ODS PDF destination (Traditional Graphics, No ODS or Listing output) ---*;
404                    ods listing close;
405        
406                    ods pdf file="&outputs_folder\WPCT-F.07.03_Box_plot_&&paramcd_val&pdx.._with_change_by_visit_for_timepoint_&&atptn_val&tdx...pdf"
407                            notoc bookmarklist=none columns=2 dpi=300 startpage=no
408                            author="(&SYSUSERID) PhUSE CS Standard Analysis Library"
409                            subject='PhUSE CS Measures of Central Tendency'
410                            title="Boxplot of &&paramcd_lab&pdx Observed Values and Change from %upcase(&B_VISN_LAB1) to %upcase(&EP_VISN_LAB1) by Visit for Analysis Timepoint &&atptn_lab&tdx"
411                            ;
412        
413        
414                  /*** LOOP 3 - FINALLY, A Graph ****************************
415                   *** - Multiple pages in case of many visits/treatments ***
416                   **********************************************************/
417        
418                    %local vdx nxtvis;
419                    %let vdx=1;
420                    %do %while (%qscan(&boxplot_block_ranges,&vdx,|) ne );
421                      %let nxtvis = %qscan(&boxplot_block_ranges,&vdx,|);
422        
423                      %*--- After page 1, force a new page in the PDF (see ODS PDF option STARTPAGE=NO, above) ---*;
424                        %if &vdx > 1 %then %do;
425                          ods pdf startpage=now;
426                        %end;
427        
428                      *--- OBSERVED values (left plot) ---*;
429                        proc sgrender data=css_plot (where=( %unquote(&nxtvis) )) template=PhUSEboxplot ;
430                          dynamic
431                                  _TITLE      = 'Observed Values'
432                                  _MARKERS    = "&t_var"
433                                  _XVAR       = 'avisitn'
434                                  _BLOCKLABEL = 'avisit'
435                                  _YVAR       = "&m_var"
436                                  _YOUTLIERS  = 'm_var_outlier'
437        
438                                  %if %length(&nxt_reflines) > 0 %then %do;
439                                    _REFLINES   = "%sysfunc(translate( &nxt_reflines, %str(,), %str( ) ))"
440                                  %end;
441        
442                                  _YLABEL     = "&&paramcd_lab&pdx"
443                                  _YMIN       = %scan(&aval_axis, 1, %str( ))
444                                  _YMAX       = %scan(&aval_axis, 3, %str( ))
445                                  _YINCR      = %scan(&aval_axis, 5, %str( ))
446                                  _N          = 'n'
447                                  _MEAN       = 'mean'
448                                  _STD        = 'std'
449                                  _DATAMIN    = 'datamin'
450                                  _Q1         = 'q1'
451                                  _MEDIAN     = 'median'
452                                  _Q3         = 'q3'
453                                  _DATAMAX    = 'datamax'
454                                  ;
455                        run;
456        
457                      *--- CHANGE values (right plot) DO NOT DISPLAY baseline visit (always zero change) ---*;
458                        proc sgrender data=css_plot (where=( &endpoint_definition AND %unquote(&nxtvis) )) template=PhUSEboxplot ;
459                          dynamic
460                                  _TITLE      = 'Change from Baseline'
461                                  _MARKERS    = "&t_var"
462                                  _XVAR       = 'avisitn'
463                                  _BLOCKLABEL = 'avisit'
464                                  _YVAR       = "&c_var"
465                                  _REFLINES   = "0"
466                                  _YLABEL     = "Change in &&paramcd_lab&pdx"
467                                  _YMIN       = %scan(&chg_axis, 1, %str( ))
468                                  _YMAX       = %scan(&chg_axis, 3, %str( ))
469                                  _YINCR      = %scan(&chg_axis, 5, %str( ))
470                                  _N          = 'c_n'
471                                  _MEAN       = 'c_mean'
472                                  _STD        = 'c_std'
473                                  _DATAMIN    = 'c_datamin'
474                                  _Q1         = 'c_q1'
475                                  _MEDIAN     = 'c_median'
476                                  _Q3         = 'c_q3'
477                                  _DATAMAX    = 'c_datamax'
478        
479                                  %if %length(&b_var) > 0 and %length(&ref_trtn) > 0 %then %do;
480                                    _PVAL       = 'pval'
481                                  %end;
482        
483                                  ;
484                        run;
485        
486                      %let vdx=%eval(&vdx+1);
487                    %end; %* --- LOOP 3 - Pages of box plots, VDX ---*;
488        
489                  *--- Release the PDF output file! ---*;
490                    ods pdf close;
491                    ods listing;
492        
493                %end; %*--- LOOP 2 - Time Points, TDX ---*;
494        
495              %end; %*--- LOOP 1 - Parameters, PDX ---*;
496        
497        
498              *--- Clean up temp data sets required to create box plots ---*;
499                %if &cleanup %then %util_delete_dsets(css_nextparam css_nexttimept &css_pval_ds css_stats css_plot);
500        
501            %mend boxplot_each_param_tp;
502        
503            %boxplot_each_param_tp;
