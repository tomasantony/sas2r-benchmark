1          /*** normal distribution ******/
2          %macro normal (size=200, mu1=22, sd1=10, Delta=20, sd2=10, PCT=100);
3          	data final;
4          	     category='test';
5          		 do study_id=1 to 3;
6          		     do n=1 to &size ;
7          			  trt=1;
8          			  if study_id=3 then do;
9          				  a1=&mu1+sqrt(&SD1)*rannor(-1)+10;
10         				  bse=&mu1+sqrt(&SD1)*rannor(-1)+10;
11         				  output;
12         			  end;
13         			  else if study_id<3 then do;
14                         a1=&mu1+sqrt(&SD1)*rannor(-1);
15         				bse=&mu1+sqrt(&SD1)*rannor(-1);
16         			  output;
17         			  end;
18         			  trt=2;
19         			  bse=&mu1+sqrt(&SD1)*rannor(-1);
20         			  if n>&size*(&PCT/100) then a1=&mu1+sqrt(&SD1)*rannor(-1);
21         	          else
22         			  a1=&mu1+&delta+sqrt(&SD2)*rannor(-1);
23         			  output;
24         			end;
25         		 end;
26         	Run;
27          proc sort data=final;
28           by study_id;
29             data final;
30         	 set final;
31         	 by study_id;
32         	 if first.study_id then do;
33         		 xorg=0;
34         		 yorg=0;
35         		 xend=50;
36         		 yend=50;
37         	 end;
38         	 if trt=1 then treatment='A';
39         	 if trt=2 then treatment='B';
40         	 id=compress('Study'||study_id||'_TRT_'||treatment);
41         	run;
42         
43          %mend normal;
