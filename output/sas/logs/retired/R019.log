353        
354            %macro boxplot_each_param_tp(plotds=css_anadata, cleanup=1);
355        
356              %local pdx tdx css_pval_ds;
357        
358              %do pdx = 1 %to &paramcd_n;
359        
360                /*** LOOP 1 *****************************************************
361                 *** Loop through each PARAMETER, working with ALL TIMEPOINTS ***
362                 ****************************************************************/
363                  data css_nextparam;
364                    set &plotds (where=(paramcd = "&&paramcd_val&pdx"));
365                  run;
366        
367                %*--- Analysis Timepoints for this parameter: Num (&ATPTN_N), Names (&ATPTN_VAL1 ...) and Labels (&ATPTN_LAB1 ...) ---*;
368                  %util_labels_from_var(css_nextparam, &timepointn, &timepoint)
369        
370                %*--- Create NXT_REFLINES: a list of reference lines for this parameter, across all timepoints ---*;
371                  %util_get_reference_lines(css_nextparam, nxt_reflines,
372                                            low_var=&lo_var, high_var=&hi_var, ref_lines=&ref_lines)
373        
374                %*--- Y-AXIS DEFAULT: Fix Y-Axis MIN/MAX based on all timepoints for PARAM. See Y-AXIS DEFAULT, below. ---*;
375                %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                                    ---*;
376                  %util_get_var_min_max(css_nextparam, &m_var, aval_min_max, extra=&nxt_reflines)
377                  %util_get_var_min_max(css_nextparam, &c_var, chg_min_max)
378        
379        
380                %do tdx = 1 %to &atptn_n;
381        
382                  /*** LOOP 2 **************************************************************************
383                   *** Loop through each TIMEPOINT for this parameter, working with ALL Change Types ***
384                   *** NB: PROC SORT here is REQUIRED in order to merge on STAT details, below       ***
385                   *************************************************************************************/
386                    proc sort data=css_nextparam (where=(&timepointn = &&atptn_val&tdx))
387                               out=css_nexttimept;
388                      by chgtypen &visitn &tn_var;
389                    run;
390        
391                  %*--- Y-AXIS alternative: Set Y-Axis MIN/MAX based on this timepoint. See Y-AXIS alternative, above. ---*;
392                  %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range (left-hand plot, observed values). ---*;
393                  %*  %util_get_var_min_max(css_nexttimept, &m_var, aval_min_max, extra=&nxt_reflines)   *;
394                  %*  %util_get_var_min_max(css_nexttimept, &c_var, chg_min_max)                         *;
395        
396                  %*--- Create format string to display MEAN and STDDEV to default sig-digs: &UTIL_VALUE_FORMAT for measures, &CHG_VALUE_FORMAT for change ---*;
397                    %util_value_format(css_nexttimept, &m_var, sym=util_value_format)
398                    %util_value_format(css_nexttimept, &c_var, sym=chg_value_format)
399        
400                  %*--- Create macro variable BOXPLOT_BLOCK_RANGES, to subset change-type/visit into box plot pages ---*;
401                    %util_boxplot_block_ranges(css_nexttimept, blockvar=chgtypen, catvars=&visitn &tn_var)
402        
403        
404                  *--- Calculate summary statistics for VALUEs and CHANGE. KEEP LABELS of CHANGE TYPE, AVISIT and TRT for plotting, below ---*;
405                    proc summary data=css_nexttimept noprint;
406                      by chgtypen &visitn &tn_var chgtype &visit &t_var chgtypevisitn;
407                      var &m_var;
408                      output out=css_stats (drop=_type_ _freq_)
409                             n=n mean=mean std=std median=median min=datamin max=datamax q1=q1 q3=q3;
410                    run;
411        
412                    %local endpoint_definition;
413                    %let endpoint_definition = &visit = 'POST';
414        
415                    proc summary data=css_nexttimept (where=(&endpoint_definition)) noprint;
416                      by chgtypen &visitn &tn_var chgtype &visit &t_var chgtypevisitn;
417                      var &c_var;
418                      output out=css_c_stats (drop=_type_ _freq_)
419                             n=c_n mean=c_mean std=c_std median=c_median min=c_datamin max=c_datamax q1=c_q1 q3=c_q3;
420                    run;
421        
422        
423                  %*--- Add ANCOVA p-values for Endpoint: CHG = BASE + TRT (if user specified a reference arm) ---*;
424                    %if %length(&b_var) > 0 and %length(&ref_trtn) > 0 %then %do;
425        
426                      %let css_pval_ds = css_pvalues;
427        
428                      ods select parameterestimates;
429                      ods output parameterestimates = &css_pval_ds;
430        
431                      proc glm data=css_nexttimept;
432                        by chgtypen &visitn chgtypevisitn;
433                        where &endpoint_definition;
434                        class &tn_var (ref="&ref_trtn");
435                        model &c_var = &b_var &tn_var / solution;
436                      run; quit;
437        
438                      *--- UPDATE CSS_C_STATS with p-values for active arms, at Endpoint visit ---*;
439                        data temp;
440                          *--- We simply need the structure of these vars, for subsequent merge ---*;
441                          set css_c_stats (keep=chgtypen &visitn chgtypevisitn &tn_var);
442                          STOP;
443                        run;
444        
445                        data &css_pval_ds;
446                          set temp &css_pval_ds (keep=chgtypen &visitn chgtypevisitn parameter probt
447                                                 rename=(probt=pval)
448                                                 where=(parameter=:"%upcase(&tn_var)"));
449                          label pval="GLM ANCOVA p-value: Reference is %upcase(&tn_var) = &ref_trtn";
450                          &endpoint_definition;
451                          &tn_var = input(scan(parameter,-1,' '), best8.);
452                        run;
453        
454                        proc sort data=&css_pval_ds;
455                          by chgtypen &visitn &tn_var;
456                        run;
457        
458                        data css_c_stats;
459                          merge css_c_stats &css_pval_ds (keep=chgtypen &visitn &tn_var pval);
460                          by chgtypen &visitn &tn_var;
461                        run;
462        
463                        %util_delete_dsets(temp);
464                    %end;
465        
466        
467                    /***
468                      STACK statistics (do NOT merge) BELOW the plot data, one obs per TREATMENT/VISIT.
469                      NB: We need exactly ONE obs per timepoint and trt: AXISTABLE defaults to a SUM function
470                    ***/
471                    data css_plot;
472                      set css_nexttimept
473                          css_stats
474                          css_c_stats;
475        
476                      format mean %scan(&util_value_format, 1, %str( )) std %scan(&util_value_format, 2, %str( ));
477                      format c_mean %scan(&chg_value_format, 1, %str( )) c_std %scan(&chg_value_format, 2, %str( ));
478                    run;
479        
480        
481                  *--- Graphics Adjustments - Set defaults for all graphs, MISSING=' ' since most P-VALUEs are missing ---*;
482                    options orientation=landscape missing=' ';
483                    goptions reset=all;
484        
485                    ods graphics on / reset=all;
486                    ods graphics    / border=no attrpriority=COLOR;
487        
488                    title1    justify=left height=1.2 "Box Plot - &&paramcd_lab&pdx Last/Min/Max Baseline versus Last/Min/Max Post-baseline by Treatment";
489                    title2    justify=left height=1.2 "Analysis Timepoint: &&atptn_lab&tdx";
490                    footnote1 justify=left height=1.0 'Box plot type is schematic: the box shows median and interquartile range (IQR, the box height); the whiskers extend to the minimum and maximum data points';
