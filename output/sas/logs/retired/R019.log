230            /*** Data Prep
231              1. Restrict analysis to SAFETY POP (&p_fl) and ANALYSIS OBS (&a_lastfl or &a_minfl or &a_maxfl)
232              2. Plot requires a Change-type discrete variable for the X-Axis, to cluster boxes and stats
233              3. Plot requires an X-Axis variable that follows Change-type and Period (BASE or POST).
234                 ==> NB: PhUSEboxplot GTL template requires all values, BASE and POST, in one column.
235            ***/
236              %macro null;
237                /*--- Simplify dynamic processing, below, since user can specify 1, 2 or all 3 flags.
238                      Note the use of these symbols, later: If user did not supply a variable, resulting comparisons are 'N' = 'Y' (impossible).
239                      This should be easier to read (and write!) than a bunch of conditional logic for each potential flag variable.
240                ---*/
241                %if %length(&a_lastfl.&a_minfl.&a_maxfl) = 0 %then %put ERROR: (WPCT-F.07.08) All user-specified analysis flags are missing. Expect failure due to 0 obs.;
242                %if %length(&a_lastfl) = 0 %then %let a_lastfl = 'N';
243                %if %length(&a_minfl)  = 0 %then %let a_minfl  = 'N';
244                %if %length(&a_maxfl)  = 0 %then %let a_maxfl  = 'N';
245              %mend null;
246              %null;
247        
248              data css_pooled;
249                set &m_lb..&m_ds (keep=&ana_variables);
250                where &p_fl = 'Y' and (&a_lastfl = 'Y' or &a_minfl = 'Y' or &a_maxfl = 'Y');
251        
252                *--- Create Change-type Name and Number vars, to groups boxes in plots ---*;
253                  attrib chgtype length=$22 label='Identify type of obs (measure, baseline & change) as Last, Min or Max';
254        
255                  if &a_lastfl = 'Y' then do;
256                    chgtypen = 1;
