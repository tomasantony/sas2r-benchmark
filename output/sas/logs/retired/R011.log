3169       /* DISPOSITION ANALYSIS DATASET PREPROCESSING */
3170       /**********************************************/
3171       %macro ds_setup;
3172       
3173       	%put **********************************************;
3174       	%put * DISPOSITION ANALYSIS DATASET PREPROCESSING *;	
3175       	%put **********************************************;
3176       
3177       	/* used ACTARM if it is available */
3178       	%if &dm_actarm. %then %do;
3179       		proc datasets library=work;
3180       			modify dm;
3181       			rename %if &dm_arm. %then arm=plannedarm;
3182       			       actarm=arm;
3183       		quit;
3184       	%end;
3185       
3186       	data dm;
                                                           The SAS System

3187       		set dm;
3188       
3189       		%if &dm_armcd. %then %do;
3190       			if upcase(ARMCD) in("SCRNFAIL","NOTASSGN") then delete;
3191       		%end;
3192       
3193       		/* put arm into propcase */
3194       		arm_display = arm;
3195       		if arm_display ne '' and not anylower(arm_display) then do;
3196       			length arm_word $50;
3197       			i = 1;
3198       			arm_word = scan(arm_display,i);
3199       			do while (arm_word ne '');
3200       				if length(arm_word) > 3 and not anydigit(compress(arm_word))
3201       						then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) =
3201     ! propcase(compress(arm_word));
3202       				if compress(arm_word) in ('MG' 'KG')
3203       					then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = lowcase(arm_word);
3204       				if compress(arm_word) = ('ML')
3205       					then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = 'mL';
3206       				i = i + 1;
3207       				arm_word = scan(arm_display,i);
3208       			end;
3209       		end;
3210       		arm = arm_display;
3211       		drop arm_display arm_word i;
3212       	run;
3213       
3214       	data ds ;
3215       		set ds;
3216       		if not anylower(dsdecod) then dsdecod = propcase(dsdecod);
3217       
3218       		%if &ds_dscat. %then %do;
3219       			if missing(dscat) then dscat = 'Missing';
3220       			if not anylower(dscat) then dscat = propcase(dscat);
3221       		%end;
3222       		%else %do;
3223       			dscat = 'Missing';
3224       		%end;
3225       
3226       		%if &ds_dsscat. %then %do;
3227       			if missing(dsscat) then dsscat = 'Missing';
3228       			if not anylower(dsscat) then dsscat = propcase(dsscat);
3229       		%end;
3230       		%else %do;
3231       			dsscat = 'Missing';
3232       		%end;
3233       	run;
