3129       	quit;  	
3130       
3131       	/* study day of disposition event OR (start date of disposition event AND subject reference start date) */
3132       	%chk_var(ds=ds,var=dsstdtc);
3133       	%chk_var(ds=ds,var=dsstdy);	
3134       	%chk_var(ds=dm,var=rfstdtc);
3135       
3136       	proc sql noprint;
3137       		insert into rpt_chk_var_req
3138       		set chk = 'VAR',
3139       		    ds = 'DM/DS',
3140       			var = 'DSSTDY or (DSSTDTC and RFSTDTC)',
3141       			condition = 'EXISTS',
3142       			ind = %sysfunc(ifc(&ds_dsstdy. or (&ds_dsstdtc. and &dm_rfstdtc.),1,0));
3143       	quit;  	
3144       
3145       	/* set a flag indicating whether all required variables are present */
3146       	%global all_req_var;
3147       	proc sql noprint;
3148       		select (case when count = 0 then 1 else 0 end) into: all_req_var
3149       		from (select count(1) as count
3150                     from rpt_chk_var_req
3151                     where ind ne 1);
3152       	quit;
