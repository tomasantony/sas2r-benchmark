3235       	*data ex;
3236       	*	set ex;
3237       	*run;
3238       
3239       	* Obtain demographics and people for each of the disposition terms;
3240       	proc sort data = dm;
3241       	  by usubjid;
3242       	run;
3243       
                                                           The SAS System

3244       	proc sort data = ds;
3245       	  by usubjid;
3246       	run;
3247       
3248       	proc sort data = ex nodupkey;
3249       	  by usubjid;
3250       	run;
3251       
3252       	data dm_ds;
3253       		merge dm (in=b) ds (in=a);
3254       		by usubjid;
3255       		if  a and b;
3256       	run;
3257       
3258       
3259       	data dm_ds;
3260       		set dm_ds;
3261       
3262       		%if &ds_dsstdy. %then %do;
3263       			dsdy = dsstdy;
3264       		%end;
3265       
3266       		%else %if &dm_rfstdtc. and &ds_dsstdtc. %then %do;
3267       			dss_year  = substr(left(dsstdtc),1,4);
3268       			dss_month = substr(left(dsstdtc),6,2);
3269       			dss_day   = substr(left(dsstdtc),9,2);
3270       			dss_date  = mdy( dss_month, dss_day, dss_year);
3271       
3272       			rfs_year  = substr(left(rfstdtc),1,4);
3273       			rfs_month = substr(left(rfstdtc),6,2);
3274       			rfs_day   = substr(left(rfstdtc),9,2);
3275       			rfs_date  = mdy( rfs_month, rfs_day, rfs_year);
3276       
3277       			if dss_date >= rfs_date then do;
3278       				dsdy = (dss_date - rfs_date + 1);
3279       			end;
3280       			else do;
3281       				dsdy = (dss_date - rfs_date);
3282       			end;
3283       		%end;
3284       
3285       		%else %do;
3286       			length dsdy 8. dsstdy 8. rfstdtc $1 dsstdtc $1;
3287       			call missing(dsdy,dsstdy,rfstdtc,dsstdtc);
3288       		%end;
3289       	run;
