3102       %macro ds_prelim_check;
3103       
3104       	/* check whether there are subjects in DM */
3105       	%chk_dm_subj_gt0;
3106       
3107       	/* required variables */
3108       	%chk_var(ds=dm,var=usubjid);
3109       	%chk_var(ds=ds,var=dsdecod);
3110       	%chk_var(ds=ds,var=usubjid);
3111       	%chk_var(ds=ex,var=usubjid);
3112       
3113       	data rpt_chk_var_req;
3114       		set rpt_chk_var;
3115       	run;
3116       
3117         	/* actual arm or planned arm */
3118       	%chk_var(ds=dm,var=actarm);
3119       	%chk_var(ds=dm,var=arm);
3120       
3121       	/* insert a row into RPT_CHK_VAR_REQ indicating whether actual arm OR arm exists */
3122       	proc sql noprint;
3123       		insert into rpt_chk_var_req
3124       		set chk = 'VAR',
3125       		    ds = 'DM',
3126       			var = 'ACTARM or ARM',
3127       			condition = 'EXISTS',
3128       			ind = %sysfunc(ifc(&dm_actarm. or &dm_arm.,1,0));
