3422       	data by_dsdecode (drop=total_count num_by_cat arm I arm_n);
3423       		  set by_cat_arm;
3424       		  by dscat dsscat dsdecod;
3425       		  retain n_arm1 - n_arm%eval(&num_random.) n1 - n%eval(&num_random.) p_arm1 - p_arm%eval(&num_random.) name1 -
3425     ! name%eval(&num_random.);
3426       		  format name1 - name%eval(&num_random.) $100.;
3427       		  array ns{*} n_arm1 - n_arm%eval(&num_random.);
3428       		  array nds{*} n1 - n%eval(&num_random.);
3429       		  array percs{*} p_arm1 - p_arm%eval(&num_random.);
3430       		  array names{*} $ name1 - name%eval(&num_random.);
3431       
3432       		ns{arm_n} = total_count;
3433       		nds{arm_n} = num_by_cat;
3434       		percs{arm_n} = 100*num_by_cat/total_count;
3435       		names{arm_n} = arm;
3436       
3437       		dscat = propcase(dscat);
3438       		dsdecod = propcase(dsdecod);
3439       		if index(dscat,'Mile') then sorter = 1;
3440       		  else sorter = 2;
3441       
3442       		if last.dsdecod then do;
3443       		  tot_perc = sum(of p_arm:);
3444       		  output;
3445       		  do I = 1 to &num_random.;
3446       		     nds{I} = 0;
3447       		     percs{I} = 0;
3448       		  end;
3449       		end;
3450       	run;
