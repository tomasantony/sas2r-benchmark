3611       		** NOW RUN THROUGH AND DO THE CUMMULATIVE NUMBER OF EACH EVENT AND ALL THE NUMBER OF DAYS ***;
3612       
3613       		data by_dsdecod_day1 (keep = arm dsdecod dsdy1 cum_dsdecod);
3614       			  set by_dsdecod_day;
3615       			  by arm dsdecod;
3616       			  retain cum_dsdecod;
3617       
3618       			dsdy0 = lag(dsdy);
3619       			if first.dsdecod then do;
3620       			  if dsdy < 0 then do;
3621       			    dsdy1 = dsdy;
3622       			    cum_dsdecod = by_dsdecod;
3623       			    output;
3624       			  end;
3625       			  else do;
3626       			  do J = 0 to dsdy;
3627       			    dsdy1 = J;
3628       				if dsdy1 = dsdy then cum_dsdecod = by_dsdecod;
3629       				  else cum_dsdecod = 0;
3630       				output;
3631       			  end;
3632       			  end;
3633       			end;
3634       			else do;
3635       			  days_between = abs(dsdy0-dsdy);
3636       			  if days_between = 1 then do;
3637       			    dsdy1 = dsdy;
3638       			    cum_dsdecod = cum_dsdecod+by_dsdecod;
3639       				output;
3640       			  end;
3641       			  else do;
3642       			    do I = 1 to days_between;
3643       				  dsdy1 = dsdy0+I;
3644       				  if dsdy1 = dsdy then 	cum_dsdecod = cum_dsdecod+by_dsdecod;
3645       				  output;
3646       				end;
3647       			  end;
3648       			end;
