3304       /**********************/
3305       %macro ds_by_arm(infile,outfile);
3306       
3307       	%put ******************************************;
3308       	%put * DISPOSITION EVENTS BY ARM for &infile. *;	
3309       	%put ******************************************;
3310       
3311       	** Revised logic part of the program starts here ****;
3312       	**IF THE VARIABLES ARE MISSING THEY WILL BE SET TO MISSING ***;
3313       
3314       	proc sort data=&infile. out=&infile._sort;
3315       		by usubjid dscat dsscat %if &ds_dsstdtc. %then dsstdtc; %else %if &ds_dsstdy. %then dsstdy;;
3316       	run;
3317       
3318       	/* keep only the last disposition event per category and subcategory */
3319       	/* keep death if there are multiple disposition events on a single day */
