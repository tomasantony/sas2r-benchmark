      OS Memory           9812.00k
      Timestamp           10/27/2026 11:28:49 AM
      Step Count                        2  Switch Count  0
      

21         
22         data evals;
23            input ID $ @6 String $9. @6 Evaluation eval.;    /*2*/
24         datalines;

