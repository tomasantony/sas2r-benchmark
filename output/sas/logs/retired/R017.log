357            %macro boxplot_each_param_tp(plotds=css_anadata, cleanup=1);
358        
359              %local pdx tdx ;
360        
361              %do pdx = 1 %to &paramcd_n;
362        
363                /*** LOOP 1 *****************************************************
364                 *** Loop through each PARAMETER, working with ALL TIMEPOINTS ***
365                 ****************************************************************/
366                  data css_nextparam;
367                    set &plotds (where=(paramcd = "&&paramcd_val&pdx"));
368                  run;
369        
370                %*--- Analysis Timepoints for this parameter: Num (&ATPTN_N), Names (&ATPTN_VAL1 ...) and Labels (&ATPTN_LAB1 ...) ---*;
371                  %util_labels_from_var(css_nextparam, atptn, atpt)
372        
373                %*--- Create NXT_REFLINES: a list of reference lines for this parameter, across all timepoints ---*;
374                  %util_get_reference_lines(css_nextparam, nxt_reflines,
375                                            low_var=&lo_var, high_var=&hi_var, ref_lines=&ref_lines)
376        
377                %*--- Y-AXIS alternative: Fix Y-Axis MIN/MAX based on all timepoints for PARAM. See Y-AXIS DEFAULT, below. ---*;
378                %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                                    ---*;
379                %*   %util_get_var_min_max(css_nextparam, &m_var, aval_min_max, extra=&nxt_reflines)   *;
380        
381        
382                %do tdx = 1 %to &atptn_n;
383        
384                  /*** LOOP 2 ********************************************************************
385                   *** Loop through each TIMEPOINT for this parameter, working with ALL VISITS ***
386                   *** NB: PROC SORT here is REQUIRED in order to merge on STAT details, below ***
387                   *******************************************************************************/
388                    proc sort data=css_nextparam (where=(atptn = &&atptn_val&tdx))
389                               out=css_nexttimept;
390                      by studyid avisitn &tn_var;
391                    run;
392        
393                  %*--- Y-AXIS DEFAULT: Set Y-Axis MIN/MAX based on this timepoint. See Y-AXIS alternative, above. ---*;
394                  %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                          ---*;
395                    %util_get_var_min_max(css_nexttimept, &m_var, aval_min_max, extra=&nxt_reflines)
396        
397                  %*--- Create format string to display MEAN and STDDEV to default sig-digs: &UTIL_VALUE_FORMAT ---*;
398                    %util_value_format(css_nexttimept, &m_var)
399        
400                  %*--- Create macro variable BOXPLOT_BLOCK_RANGES, to subset studies into box plot pages ---*;
401                    %util_boxplot_block_ranges(css_nexttimept, blockvar=studyid, catvars=&tn_var);
402        
403        
404                  *--- Calculate summary statistics, KEEP LABELS of VISIT and TRT for plotting, below ---*;
405                    proc summary data=css_nexttimept noprint;
406                      by studyid avisitn &tn_var studyvisitn avisit &t_var;
407                      var &m_var;
408                      output out=css_stats (drop=_type_ _freq_)
409                             n=n mean=mean std=std median=median min=datamin max=datamax q1=q1 q3=q3;
410                    run;
411        
412                    /***
413                      STACK statistics (do NOT merge) BELOW the plot data, one obs per TREATMENT/VISIT.
414                      NB: We need exactly ONE obs per timepoint and trt: AXISTABLE defaults to a SUM function
415                    ***/
416                    data css_plot;
417                      set css_nexttimept
418                          css_stats;
419        
420                      format mean %scan(&util_value_format, 1, %str( )) std %scan(&util_value_format, 2, %str( ));
421                    run;
422        
423        
424                  *--- Graphics Settings - Set defaults for all graphs ---*;
425                    options orientation=landscape;
426                    goptions reset=all;
427        
428                    ods graphics on / reset=all;
429                    ods graphics    / border=no attrpriority=COLOR;
430        
431                    title     justify=left height=1.2 "Box Plot - &&paramcd_lab&pdx at &c_mode Baseline and &c_mode Post-Baseline for Multiple Studies and Analysis Timepoint &&atptn_lab&tdx";
432                    footnote1 justify=left height=1.0 'Box plot type is schematic: the box shows median and interquartile range (IQR, the box height); the whiskers extend to the minimum';
433                    footnote2 justify=left height=1.0 'and maximum data points within 1.5 IQR of the lower and upper quartiles, respectively. Values outside the whiskers are shown as outliers.';
434                    footnote3 justify=left height=1.0 'Means are marked with a different symbol for each treatment. Red dots indicate measures outside the normal reference range.';
435                    footnote4 justify=left height=1.0 'Baseline and post-baseline blocks have different background colors. BASE = baseline, POST = post-baseline.';
436        
437                    %let y_axis = %util_axis_order( %scan(&aval_min_max,1,%str( )), %scan(&aval_min_max,2,%str( )) );
438        
439                  *--- ODS PDF destination (Traditional Graphics, No ODS or Listing output) ---*;
440                    ods listing close;
441                    ods pdf file="&outputs_folder\WPCT-F.07.06_Box_plot_&&paramcd_val&pdx.._&c_mode._base_post_by_study_for_timepoint_&&atptn_val&tdx...pdf"
442                            notoc bookmarklist=none dpi=300
443                            author="(&SYSUSERID) PhUSE CS Standard Analysis Library"
444                            subject='PhUSE CS Measures of Central Tendency'
445                            title="Boxplot of &&paramcd_lab&pdx at &c_mode Baseline and &c_mode Post-baseline for Multiple Studies and Analysis Timepoint &&atptn_lab&tdx"
446                            ;
447        
448        
449                  /*** LOOP 3 - FINALLY, A Graph ****************************
450                   *** - Multiple pages in case of many visits/treatments ***
451                   **********************************************************/
452        
453                    %local vdx nxtvis;
454                    %let vdx=1;
455                    %do %while (%qscan(&boxplot_block_ranges,&vdx,|) ne );
456                      %let nxtvis = %qscan(&boxplot_block_ranges,&vdx,|);
457        
458                      proc sgrender data=css_plot (where=( %unquote(&nxtvis) )) template=PhUSEboxplot ;
459                        dynamic
460                                _MARKERS    = "&t_var"
461                                _BLOCKLABEL = 'studyid'
462                                _XVAR       = 'studyvisitn'
463                                _YVAR       = "&m_var"
464                                _YOUTLIERS  = 'm_var_outlier'
465        
466                                %if %length(&nxt_reflines) > 0 %then %do;
467                                  _REFLINES   = "%sysfunc(translate( &nxt_reflines, %str(,), %str( ) ))"
468                                %end;
469        
470                                _YLABEL     = "&&paramcd_lab&pdx"
471                                _YMIN       = %scan(&y_axis, 1, %str( ))
472                                _YMAX       = %scan(&y_axis, 3, %str( ))
473                                _YINCR      = %scan(&y_axis, 5, %str( ))
474                                _PERIOD     = 'avisit'
475                                _N          = 'n'
476                                _MEAN       = 'mean'
477                                _STD        = 'std'
478                                _DATAMIN    = 'datamin'
479                                _Q1         = 'q1'
480                                _MEDIAN     = 'median'
481                                _Q3         = 'q3'
482                                _DATAMAX    = 'datamax'
483                                ;
484                      run;
485        
486                      %let vdx=%eval(&vdx+1);
487                    %end; %* --- LOOP 3 - Pages of box plots, VDX ---*;
488        
489                  *--- Release the PDF output file! ---*;
490                    ods pdf close;
491                    ods listing;
492        
493                %end; %*--- LOOP 2 - Time Points, TDX ---*;
494        
495              %end; %*--- LOOP 1 - Parameters, PDX ---*;
496        
497        
498              *--- Clean up temp data sets required to create box plots ---*;
499                %if &cleanup %then %util_delete_dsets(css_nextparam css_nexttimept css_stats css_plot);
500        
501            %mend boxplot_each_param_tp;
502        
503            %boxplot_each_param_tp;
