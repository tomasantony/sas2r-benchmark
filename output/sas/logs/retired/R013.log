4437       			if (BILI_RES GE BILI_HI*2) THEN BILIx2 = 1;
4438       			if (BILI_RES GE BILI_HI*3) then BILIx3 = 1;
4439       			if BILI_LO < BILI_RES < BILI_HI THEN BILInorm = 1;
4440       			if BILInorm = 1 and LBBLFL = "Y" then Bili_basenm = 1;
                                                           The SAS System

4441       			end;
