4382       		/*flag results above upper limit of normal*/
                                                           The SAS System

4383       		data ALParm&i.;
4384       			set ALParm&i.;
4385       			if ALP_RES = . then ALP_miss = 1;
4386       			if ALP_RES NE . THEN DO;
4387       
4388       				if (ALP_RES GE ALP_HI*2) then ALPx2 = 1;
4389       				if (ALP_RES GE ALP_HI*3) then ALPx3 = 1;
4390       				if (ALP_RES GE ALP_HI*5) then ALPx5 = 1;
4391       				if (ALP_RES GE ALP_HI*10) then ALPx10 = 1;
4392       				if (ALP_RES GE ALP_HI*20) then ALPx20 = 1;
4393       				if ALP_RES LE ALP_HI THEN ALPnorm = 1;
4394       				if ALP_RES GE ALP_HI THEN ALP_GEHI = 1;
4395       				if ALPnorm = 1 and LBBLFL = "Y" then ALP_basenm = 1;
4396       			end;
