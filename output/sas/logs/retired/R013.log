4423       			if (AST_RES GE AST_HI*5) then ASTx5 = 1;
4424       			if (AST_RES GE AST_HI*10) then ASTx10 = 1;
4425       			if (AST_RES GE AST_HI*20) then ASTx20 = 1;
4426       			if AST_LO < AST_RES < AST_HI THEN ASTnorm = 1;
4427       			if ASTnorm = 1 and LBBLFL = "Y" then AST_basenm = 1;
4428       			end;
4429       			keep arm ast ast_date ast_hi ast_lo ast_res ast_unit vnum ast_basenm
4430       			astnorm astx2 astx3 astx5 astx10 astx20 subnum usubjid /*studyid*/ LBBLFL;
4431       		run;
4432       
4433       		data BILIarm&i.;
