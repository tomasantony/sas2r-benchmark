4404       
4405       			if (ALT_RES GE ALT_HI*2) then ALTx2 = 1;
4406       			if (ALT_RES GE ALT_HI*3) then ALTx3 = 1;
4407       			if (ALT_RES GE ALT_HI*5) then ALTx5 = 1;
4408       			if (ALT_RES GE ALT_HI*10) then ALTx10 = 1;
4409       			if (ALT_RES GE ALT_HI*20) then ALTx20 = 1;
4410       			if ALT_LO < ALT_RES < ALT_HI THEN ALTnorm = 1;
4411       			if ALTnorm = 1 and LBBLFL = "Y" then ALT_basenm = 1;
4412       			end;
4413       			keep arm alt alt_date alt_hi alt_lo alt_res alt_unit vnum alt_basenm
4414       			altnorm altx2 altx3 altx5 altx10 altx20 subnum usubjid /*studyid*/ LBBLFL;
4415       		run;
4416       
4417       		data ASTarm&i.;
4418       			set ASTarm&i.;
