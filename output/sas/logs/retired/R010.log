2869       
2870       	/* set indicator whether all required variables are present */
2871       	%global setup_req_var;
2872       	proc sql noprint;
2873       		select (case when count = 0 then 1 else 0 end) into: setup_req_var
2874       		from (select count(1) as count
2875                     from rpt_chk_var_req
2876                     where ind ne 1);
2877       	quit;
2878       
2879       	%if &dm_subj_gt0. and &setup_req_var. %then %do;
2880       
2881       		%global setup_success;
2882       		%let setup_success = 1;
2883       
2884       		/* used ACTARM if it is available */
2885       		%if &dm_actarm. %then %do;
2886       			proc datasets library=work;
2887       				modify dm;
2888       				rename %if &dm_arm. %then arm=plannedarm;
                                                           The SAS System

2889       				       actarm=arm;
2890       			quit;
2891       		%end;
2892       
2893       		/* arm info */
2894       		proc sql noprint;
2895       			create table lkp_arm as
2896       			select arm, count(1) as arm_count
2897       			from dm	
2898       			where upcase(armcd) not in ('SCRNFAIL','NOTASSGN')
2899       			/*and upcase(arm) ne 'SCREEN FAILURE'*/
2900       			group by arm
2901       			order by arm;
2902       		quit;
2903       
2904       		/* get arm counts and total count; assign arm numbers */
2905       		data lkp_arm;
2906       			set lkp_arm end=eof;
2907       
2908       			arm_num = _n_;
2909       
2910       			/* format arm name */
2911       			arm_display = arm;
2912       			if arm_display ne '' and not anylower(arm_display) then do;
2913       				length arm_word $50;
2914       				i = 1;
2915       				arm_word = scan(arm_display,i);
2916       				do while (arm_word ne '');
2917       					if length(arm_word) > 3 and not anydigit(compress(arm_word))
2918       							then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) =
2918     ! propcase(compress(arm_word));
2919       					if compress(arm_word) in ('MG' 'KG')
2920       						then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = lowcase(arm_word);
2921       					if compress(arm_word) = ('ML')
2922       						then substr(arm_display,index(arm_display,compress(arm_word)),length(compress(arm_word))) = 'mL';
2923       					i = i + 1;
2924       					arm_word = scan(arm_display,i);
2925       				end;
2926       			end;
2927       
2928       			retain total_count 0;
2929       			total_count = total_count + arm_count;
2930       
2931       			call symputx('arm_name_'||put(arm_num,8. -l),trim(arm_display),'g');
2932       			call symputx('arm_count_'||put(arm_num,8. -l),trim(put(arm_count,8. -l)),'g');
2933       			if eof then do;	
2934       				call symputx('arm_count',trim(put(_n_,8. -l)),'g');
2935       				call symputx('total_count',trim(put(total_count,8. -l)),'g');
2936       			end;
2937       		run;
2938       
2939       		data lkp_arm_out;
2940       			retain arm arm_count;
2941       			set lkp_arm(keep=arm_display arm_count total_count rename=(arm_display=arm)) end=eof;
2942       			output;
2943       			if eof then do;
2944       				arm = 'Overall';
2945       				arm_count = total_count;
