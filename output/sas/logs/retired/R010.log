3477       			if a and not b and num(i) = . then num(i) = 0;
3478       		end;
3479       		drop i;
3480       	run;
3481       
3482       	proc sort data=ds_&var._ct_cp; by &var. dsdecod; run;
3483       
3484       	/* tranpose so arm counts are stored in separate columns */
3485       	proc transpose data=ds_&var._ct_cp out=ds_&var._count(drop=_name_ _label_) prefix=arm_ suffix=_count;
3486       		by &var. dsdecod;
3487       		id arm_num;
3488       		var count;
3489       	run;
3490       
3491       	/* and again for percentages */
3492       	proc transpose data=ds_&var._ct_cp out=ds_&var._percent(drop=_name_) prefix=arm_ suffix=_percent;
3493       		by &var. dsdecod;
3494       		id arm_num;
3495       		var percent;
3496       	run;
3497       
3498       	data ds_&var.;
3499       		merge ds_&var._count(in=a)
3500       		      ds_&var._percent(in=b);
3501       		by &var. dsdecod;
3502       	run;
3503       
3504       	/* find total counts and percentages */
3505       	data ds_&var.;
3506       		retain dsdecod &var. %do di = 1 %to &arm_count.; arm_&di._count arm_&di._percent %end;;
3507       		merge ds_&var.(in=a)
3508                     ds_&var._ct_sc(in=b);
3509       			  if a;
3510       		by &var.;
3511       		
3512       		total_count = %do di = 1 %to &arm_count; arm_&di._count + %end; 0;
3513       		if subgroup_count ne 0 then total_percent = 100*total_count/subgroup_count;
3514       		/*else total_percent = 0;*/
3515       
3516       		drop subgroup_count;
3517       	run;
3518       
3519       	proc sort data=ds_&var.; by dsdecod descending total_percent; run;
3520       
3521       /*	proc datasets library=work nolist nodetails; delete ds_&var._:; quit;*/
3522       
3523       %mend dm_by_ds;
