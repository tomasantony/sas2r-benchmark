3237       %macro dm(var);
3238       
3239       	%put DEMOGRAPHICS: &var.;
3240       
3241       	data _null_;
3242       		var = "&var.";
3243       		outds = translate(var,'_','*');
3244       		varlist = translate(var,',','*');
3245       		keylist = substr(var,1,length(trim(var)) - index(reverse(left(trim(var))),'*'));
3246       
3247       		call symputx('outds',outds);
3248       		call symputx('varlist',varlist);
3249       		call symputx('keylist',keylist);
3250       	run;
3251       
3252       	proc sql noprint;
3253       		create table dm_&outds. as
3254       		select &varlist.,
3255       		       %do di = 1 %to &arm_count.;
3256                         arm_&di._count label="&&&arm_name_&di. Count",
3257       				  100*arm_&di._count/&&&arm_count_&di. as arm_&di._pct label="&&&arm_name_&di. %",
3258       			   %end;
3259       			   total_count label='Total Count',
3260       			   100*total_count/&total_count. as total_pct label='Total %'
3261       		from (select &varlist.,
3262       		             %do di = 1 %to &arm_count.;
3263       					    sum(case when arm_num = &di. then 1 else 0 end) as arm_&di._count,
3264       					 %end;
3265       					 count(1) as total_count
3266       			  from dm
3267       			  group by &varlist.)
3268       		order by &keylist., total_count desc;
3269       	quit;
3270       	
3271       %mend dm;
