2829       
2830         	/* actual arm or planned arm */
                                                           The SAS System

2831       	%chk_var(ds=dm,var=actarm);
2832       	%chk_var(ds=dm,var=arm);
2833       
2834       	/* insert a row into RPT_CHK_VAR_REQ indicating whether actual arm OR arm exists */
2835       	proc sql noprint;
2836       		insert into rpt_chk_var_req
2837       		set chk = 'VAR',
2838       		    ds = 'DM',
2839       			var = 'ACTARM or ARM',
2840       			condition = 'EXISTS',
2841       			ind = %sysfunc(ifc(&dm_actarm. or &dm_arm.,1,0));
2842       	quit;
2843       
2844       	/* study day of disposition event OR start date of disposition event */
2845       	%chk_var(ds=ds,var=dsstdtc);
2846       	%chk_var(ds=ds,var=dsstdy);	
2847       
2848       	proc sql noprint;
2849       		insert into rpt_chk_var_req
2850       		set chk = 'VAR',
2851       		    ds = 'DM/DS',
2852       			var = 'DSSTDY or DSSTDTC',
2853       			condition = 'EXISTS',
2854       			ind = %sysfunc(ifc(&ds_dsstdy. or &ds_dsstdtc.,1,0));
2855       	quit;  	
