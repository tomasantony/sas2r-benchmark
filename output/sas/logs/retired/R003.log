92          */
93         
94         data annoraw;
95          set two;
96          length function $8;
97          retain function color text size xsys ysys when;
98          if lab_test_1>9 or .<lab_test_1<5.5;
99          if lab_test_1>9 then TE_High=1;
100         else TE_High=0;
101         if lab_test_1<5.5 then TE_low=1;
102         else TE_low=0;
103          When='A'; /*'A' indcates the symbol will be draw after the plot
103      ! procedure
104                     'A' means the annote symbol is in the front of the plot
105                     'B' indcates the symbol will be draw before the plot
105      ! procedure
106                     'B' means the annote sumbol is at the back of the plot
107                    */
108         xsys='2'; /* xsys= specifies a value that represents a coordinate
108      ! system.
109                      '2' means the Coordinate System Unit = data values */
110         ysys='2';
111         color = "red ";
112         function = "symbol "; * create a symbol;
113         text = "dot "; * (a filled circle);
114         size = 0.5;
115         x=ttpoint;
116         y=lab_test_1;
117        run;

