10         
11         AND
12            "An easier way to create a calibration plot in SAS"
13            by Rick Wicklin, published 20FEB2019 on The DO Loop blog:
14            https://blogs.sas.com/content/iml/2019/02/20/easier-calibration-plot-sas.html
15         
16            This program shows how to
17            - Manually create a calibration plot (with a loess fit) for a
18              logistic model with a binary response.
19            - Manually create a decile calibration plot for a logistic model
20              with a binary response.
21            - Automatically generate a calibration plot by using the PLOTS=CALIBRATION
22              option on the PROC LOGISTIC statement.
23         
24            The data are simulated according to a paper by
25            Hosmer, Hosmer, Le Cessie, and Lemeshow (1997)
26         
27         REFERENCES:
28            Graphical methods of assessing calibration, based on
29            Hosmer, Hosmer, Le Cessie, and Lemeshow (1997)
30            "A comparison of goodness-of-fit tests for the logistic regression model,"
31            https://www2.stat.duke.edu/~zo2/dropbox/goflogistic.pdf
32            and referenced in
33            Austin and Steyerberg (2013)
34            "Graphical assessment of internal and external calibration of logistic regression
35             models by using loess smoothers"
36            https://doi.org/10.1002/sim.5941
37         
38            Get quadratic coefficients from
39            https://www2.stat.duke.edu/~zo2/dropbox/goflogistic.pdf
40            as implemented in My SAS Files/blog/CalibrationParams.sas
41         */
42         
43         /* Step 1: Simulate data for a quadratic logistic regression model */
44         /* simulate sample of size N=500 that follows a quadratic model from Hosmer et al. (1997) */
45         %let N = 500;                              /* sample size */
46         data LogiSim(keep= Y x);
47         call streaminit(1234);              /* set the random number seed */
48         do i = 1 to &N;                      /* for each observation in the sample  */
49            /* Hosmer et al. chose x ~ U(-3,3). Use rand("Uniform",-3,3) for modern versions of SAS */
50            x = -3 + 6*rand("Uniform");
51            eta = -2.337 + 0.8569*x + 0.3011*x**2;  /* quadratic model used by Hosmer et al. */
52            mu = logistic(eta);
53            Y = rand("Bernoulli", mu);
54            output;
55         end;
56         run;

