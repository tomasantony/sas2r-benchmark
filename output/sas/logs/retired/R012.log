3736       /****************************************************/
3737       /* CREATE THE PLANNED ARM VS ACTUAL TREATMENT TABLE */
3738       /****************************************************/
3739       %macro ex_4;
3740       
3741       	%put ************************************;
3742       	%put * 4. ANALYSIS D: PLANNED VS ACTUAL *;	
3743       	%put ************************************;
3744       
3745       	/* EXTRT, EXDOSE, and EXDOSU must exist to run this analysis */
3746       	%if &dm_arm. and &ex_extrt. and &ex_exdose. and &ex_exdosu. %then %do;
3747       
3748       		proc sql noprint;
3749       			/* find out how many subjects there were per planned arm */
3750       			create table ex_d_planned as
3751       			select arm, count(distinct usubjid)	as arm_count
3752       			from (select a.usubjid,
3753                                %if &dm_actarm. %then plannedarm;
3754       						 %else arm;	as arm
3755       			      from dm a,
3756       				       ex b
3757       				  where a.usubjid = b.usubjid)
3758       			group by arm;
3759       
3760       			/* find the number of subjects per treatment and dose */
3761       			create table ex_d_actual as
3762       			select arm, extrt, exdose, exdosu, count(distinct usubjid) as extrt_count
3763       			from (select a.usubjid,
3764                                %if &dm_actarm. %then plannedarm;
3765       	                     %else arm; as arm,
3766                                extrt, exdose, exdosu
3767       			      from ex a,
3768       				       dm b
3769       		          where a.usubjid = b.usubjid)
3770       			group by arm, extrt, exdose, exdosu;
3771       
3772       			/* combined the planned and actual counts */
3773       			create table ex_d_pva as
3774       			select a.arm, arm_count, extrt, exdose, exdosu, extrt_count
3775       			from ex_d_planned a,
3776       			     ex_d_actual b
3777       			where a.arm = b.arm
3778       			order by arm, extrt, exdose, exdosu;
3779       		quit;
3780       
3781       		/* format the planned vs. actual table for output */
3782       		data final_exposureD;
3783       			retain arm arm_count actual actual_dose actual_count;
3784       			set ex_d_pva;
3785       			by arm extrt exdose;
3786       
3787       			if not first.arm then do;
3788       				arm = '';
3789       				arm_count = .;
                                                           The SAS System

3790       			end;
3791       
3792       			if not first.extrt then extrt = '';
3793       
3794       			extrt = propcase(extrt);
3795       
3796       			length actual $100 actual_dose $100;
3797       			actual = extrt;
3798       			actual_dose = left(ifc(not missing(exdose),compress(exdose),'')||' '||
3799       		                  ifc(not missing(exdosu),exdosu,''));
3800       			actual_count = extrt_count;
3801       
3802       			keep arm arm_count actual actual_dose actual_count;
3803       		run;
3804       
3805       	%end;
3806       	/* if the variables necessary for this table don't exist, create an error message */
3807       	%else %do;
3808       
3809       		data final_exposureD;
3810       			err_msg = '';
3811       		 run;
3812       
3813       		/* determine which necessary variables were missing and compose an appropriate error message */
3814       		data final_exposureD_err;
3815       			length missvar $100;
3816       			missvar = compbl(ifc(&ex_extrt. ne 1,'EXTRT','')||' '||
3817                                    ifc(&ex_exdose. ne 1,'EXDOSE','')||' '||
3818                                    ifc(&ex_exdosu. ne 1,'EXDOSU','')
3819                                    );
3820       
3821       			if not (&ex_extrt. and &ex_exdose. and &ex_exdosu.) then do;
3822       				select (ifn(&ex_extrt. ne 1,1,0) + ifn(&ex_exdose. ne 1,1,0) + ifn(&ex_exdosu. ne 1,1,0));
3823       					when (1) ;
3824       					when (2) missvar = tranwrd(trim(missvar),' ',' and ');
3825       					otherwise do;
3826       						missvar = tranwrd(trim(missvar),' ',', ');
3827       						lastcomma = length(trim(missvar)) - index(left(reverse(missvar)),',') + 1;
3828       						missvar = substr(missvar,1,lastcomma-1)||', and '||substr(missvar,lastcomma+1);
3829       					end;
3830       				end;
3831       			end;
3832       
3833       			call symputx('extrt_missvar',missvar,'g');
3834       
3835       			missvar = compbl(missvar);
3836       
3837       			err_msg = 'Planned treatment could not be compared to actual treatment because '||
3838       			          ifc(not &dm_arm.,'ARM did not exist in the DM dataset ','')||
3839       					  ifc(not &dm_arm. and not (&ex_extrt. and &ex_exdose. and &ex_exdosu.),'and ','')||
3840                             ifc(not (&ex_extrt. and &ex_exdose. and &ex_exdosu.),
3841                                 trim(missvar)||' did not exist in the EX dataset','');
