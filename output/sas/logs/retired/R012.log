3263       /*****************************************/
3264       /* 1. ANALYSIS A: NUMBER OF DAYS ON DRUG */
3265       /*****************************************/
3266       %macro ex_1;
3267       
                                                           The SAS System

3268       	%put *****************************************;
3269       	%put * 1. ANALYSIS A: NUMBER OF DAYS ON DRUG *;	
3270       	%put *****************************************;
3271       
3272       	** GET THE LAST OBS BY ID ***;
3273       
3274       	data ex_dm2;
3275       		set ex_dm;
3276       		by usubjid;
3277       		/* get last nonmissing exposure event */
3278       		where studydays ne .;
3279       		if last.usubjid then output ex_dm2;
3280       	run;
3281       
3282       	** NUMBER OF PEOPLE EACH DAY ***;
3283       	proc summary data = ex_dm2;
3284       	  class studydays arm;
3285       	  output out = num_days;
3286       	run;
3287       
3288       	** KEEP THE RIGHT OBS ***;
3289       
3290       	proc sort data = num_days (where=(_type_ in (1,3)));
3291       	  by arm studydays;
3292       	run;
3293       
3294       	** FIGURE OUT THE NUMBER OF TREATMENTS **;
3295       
3296       	proc sort data = num_days nodupkey out = num_treatments;
3297       	  by arm;
3298       	run;
3299       
3300       	** MAKE THE NUMBER OF TREATMENTS A MACRO **;
3301       	%global num_treatments;
3302       	proc sql noprint;
3303       	  select count(*) into: num_treatments
3304       	  from num_treatments;
3305       	quit;
3306       
3307       	** SET UP A LOOK TO DO ALL OF THE TREATMENTS ***;
3308       	%do d = 1 %to &num_treatments;
3309       
3310       		data treatment;
3311       		  set num_treatments;
3312       		if _N_ = &D;
3313       		run;
3314       
3315       		proc sql noprint;
3316       		  select arm into: treatment
3317       		  from treatment;
3318       		quit;
3319       
3320       
3321       		** MAX DAYS **;
3322       		proc sql noprint;
3323       		  select max(studydays) into: max_days
3324       		  from num_days
3325       		  where arm = "&treatment.";
                                                           The SAS System

3326       		quit;
3327       
3328       		** CREATE A DATASET CONTAINING ALL POSSIBLE DAYS ***;
3329       		data all_days(drop=I);
3330       		  do I = 1 to &max_days;
3331       		    arm = "&treatment.";
3332       		    studydays = I;
3333       			output;
3334       		  end;
3335       		run;
3336       
3337       		** MERE ALL POSSIBLE DAYS ONTO THE DATASET **;
3338       		data num_days&D;
3339       		  merge num_days all_days;
3340       		  by arm studydays;
3341       		  if arm = "&treatment.";
3342       		  if missing(_freq_) then _freq_ = 0;
3343       		run;
3344       
3345       		data _null_;
3346       		treatment2 = compress("&treatment.",'.');
3347       		call symput('treatment2',treatment2);
3348       		run;
3349       
3350       
3351       		** FIGURE OUT THE NUMBER REMAINING AT EACH DAY OF THE STUDY **;
3352       		data num_days&D(keep = studydays ARM_&D);
3353       			  set num_days&D;
3354       			  retain total_study left_in_study;
3355       
3356       			if _type_ = 1 then do;
3357       			  total_study = _freq_;
3358       			  left_in_study = _freq_;
3359       			  studydays = 0;
3360       			end;
3361       			else left_in_study = sum(left_in_study, - _freq_);
3362       			ARM_&D. = left_in_study / total_study;
3363       			label arm_&D = "&treatment2."
3364       			      studydays = 'Day of Study';
3365       			studydays = studydays+1;
3366       		run;
3367       
3368       		/* sort for the merge to follow */
3369       		proc sort data=num_days&D;
3370       			by studydays;
3371       		run;
3372       
3373       	%end;
3374       
3375       
3376       	** MERGE THE DATA BACK TOGETHER TO MAKE ONE SET **;
3377       
3378       	data final_ExposureA;
3379       		merge
3380       		%do S = 1 %to &num_treatments;
3381       		  num_days&S.
3382       		%end;
3383       		;
                                                           The SAS System

3384       		by studydays;
3385       
3386       		if studydays < 1 then delete;
3387       
3388       		array num{*} _numeric_;
3389       		do i = 1 to dim(num);
3390       			if num(i) = . then num(i) = 0;
3391       		end;
3392       		drop i;
3393       	run;
