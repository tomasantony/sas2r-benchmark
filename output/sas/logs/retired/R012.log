3221       		if match = 1 then do;
3222       			declare hash h(dataset:'exdosfrq');
3223       			h.definekey('exdosfrq');
3224       			h.definedata('exdosfrqn','unit');
3225       			h.definedone();
3226       		end;
3227       
3228       		length exdosfrqn 8. unit $1;
3229       		label exdosfrqn='Dosing Frequency Per Interval' unit='Dosing Frequency Unit';
3230       		call missing(exdosfrqn,unit);
3231       		rc = h.find();
3232       		drop rc;
3233       
3234       		/* if no dose frequency was found, assume one dose per study day */
3235       		if exdosfrqn = . then do;
3236       			exdosfrqn = 1;
3237       			unit = 'd';
3238       		end;
3239       
3240       		/* special case to deal with injections */
3241       		/* only one injection per exposure event */
3242       		if index(upcase(exdosfrm),'INJECTION') then do;
3243       			exdosfrqn = 1;
3244       			unit = 'o';
3245       		end;
3246       
3247       		select (unit);
3248       			when ('h') dose_days_fu = dose_days * 24;
3249       			when ('d') dose_days_fu = dose_days;
3250       			when ('w') dose_days_fu = dose_days / 7;
3251       			when ('m') dose_days_fu = dose_days / 30.4375;
3252       			when ('o') dose_days_fu = 1;
3253       			otherwise;
3254       		end;
3255       
3256       		doses = dose_days_fu * exdosfrqn;
3257       
3258       	run;
3259       
3260       %mend ex_setup;
