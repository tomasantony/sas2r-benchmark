3851       /*******************/
3852       /* CHANGES IN DOSE */
3853       /*******************/
3854       %macro ex_5;
3855       
3856       	%put *******************************;
3857       	%put * 5. ANALYSIS E: DOSE CHANGES *;	
3858       	%put *******************************;
3859       
3860       	/* EXTRT, EXDOSE, and EXDOSU must exist to run this analysis */
3861       	%if &ex_extrt. and &ex_exdose. and &ex_exdosu. %then %do;
3862       
3863       		** LOOK FOR CHANGES IN DOSE ***;
3864       
3865       		** OUTPUT IF THERE IS A CHANGE IN TREATMENT OR DOSE FROM ONE RECORD TO THE NEXT ****;
3866       		data ex2;
3867       			set ex_dm;
3868       			format change_date mmddyy10. exadj $50.;
3869       			usubjid0 = lag(usubjid);
3870       			extrt0 = lag(extrt);
3871       			exdose0 = lag(exdose);
3872       			exdosu0 = lag(exdosu);
3873       			if exendtc ne "" then change_date = input(exendtc, yymmdd10.);
3874       			  else change_date = treatdate ;
3875       			if usubjid0 = usubjid;
3876       			if (extrt0 ne extrt) or (exdose0 ne exdose);
3877       			old_dose = left(trim(extrt0)|| ' '||compress(exdose0)||' '||compress(exdosu0));
3878       			new_dose = left(trim(extrt)|| ' '||compress(exdose)||' '||compress(exdosu));
3879       			if exadj = '' then exadj = 'Not Given';
3880       			else exadj = propcase(exadj);
3881       			label old_dose = 'Original Dose'
3882       			      new_dose = 'New Dose'
3883       				  usubjid = 'Subject ID'
3884       				  change_date = 'Change Date'
3885       				  studydays	= 'Day of Study'
3886       				  ;
3887       		run;
3888       
3889       
3890       		** SEE IF THERE WAS A CHANGE IN COUNT FOR OUTPUT **;
3891       
3892       		proc sql noprint;
3893       		  select count(*) into: changes
3894       		  from ex2;
3895       		quit;
3896       
3897       		%if %eval(&changes.) = 0 %then %do;
3898       
3899       			data final_exposureE;
3900       				usubjid = "No Reported Change in Dose";
3901       			run;
3902       
3903       		%end;
3904       		%else %do;
3905       
                                                           The SAS System

3906       			proc sql;
3907       			  create table final_exposureE
3908       			  as select usubjid, old_dose, new_dose, change_date, studydays, exadj
3909       			  from ex2
3910       			  order by usubjid, change_date;
3911       			;
3912       			quit;
3913       
3914       			data final_exposureE;
3915       				set final_exposureE(obs=2500) end=eof;
3916       				by usubjid change_date;
3917       				if not first.usubjid then do;
3918       					usubjid = '';
3919       				end;
3920       				output;
3921       				if _n_ = 2500 and eof then do;
3922       					usubjid = 'Over 2500 changes in dose';
3923       					old_dose = 'List truncated at 2500';
3924       					new_dose = '';
3925       					studydays = .;
3926       					exadj = '';
3927       					output;
3928       				end;
3929       			run;
3930       
3931       		%end;
3932       
3933       	%end;
3934       	%else %do;
3935       
3936       		data final_exposureE;
3937       			usubjid = '';
3938       		 run;
3939       
3940       		/* determine which necessary variables were missing and compose an appropriate error message */
3941       		data final_exposureE_err;
3942       			length missvar $100;
3943       			missvar = "&extrt_missvar.";
3944       
3945       			err_msg = compbl('Changes in dose could not be determined because '||
3946                             trim(missvar)||' did not exist in the EX dataset.');
3947       			keep err_msg;
3948       		 run;
3949       
3950       	%end;
3951       
3952       %mend ex_5;
