3600       /********************/
3601       /* BOXPLOT OF DOSES */
3602       /********************/
3603       %macro ex_3;
3604       
3605       	%put ***********************************;
3606       	%put * 3. ANALYSIS C: BOXPLOT OF DOSES *;	
3607       	%put ***********************************;
3608       
3609       	** NOW DO THE DOSE STATS ***;
3610       
3611       
3612       	** GET THE DESCRIPTIVE STATS BY ARM ***;
3613       
3614       	proc univariate data = by_usubjid (where=(doses >= 0)) noprint;
3615       	  class arm;
                                                           The SAS System

3616       	  var doses;
3617       	  output out = final_stats n=n_subjects std=sd_doses mean=mean_doses min=min_doses max=max_doses
3618       	                                                 median=median_doses q1=q1_doses q3=q3_doses mode=mode_doses
3619       	                                                 p10=p10_doses p90=p90_doses;
3620       	run;
3621       
3622       	** DETERMINE THE NUMBER OF ARMS ***;
3623       	%global num_arms;
3624       	proc sql noprint;
3625       	  select count(*) into: num_arms
3626       	  from final_stats;
3627       	quit;
3628       
3629       
3630       	%do I = 1 %to &num_arms.;
3631       
3632       		data _null_;
3633       		  set final_stats;
3634       		  if _N_ = &I;
3635       		  call symput('arm',arm);
3636       		  call symput('arm_2',compress(arm,'.'));
3637       		run;
3638       
3639       		** TRANSFORM THE DATA TO VERTICAL **;
3640       		data arm&I.(keep = sort_order arm&I.);
3641       			  set final_stats;
3642       			  format sort_order $20.;
3643       			if arm = "&arm.";
3644       			label arm&I. = "&arm_2.";
3645       
3646       			sort_order = '01 Mean';
3647       			arm&I. = mean_doses;
3648       			output;
3649       			sort_order = '02 SD';
3650       			arm&I. = sd_doses;
3651       			output;
3652       			sort_order = '03 Median';
3653       			arm&I. = median_doses;
3654       			output;
3655       			sort_order = '04 P10';
3656       			arm&I. = p10_doses;
3657       			output;
3658       			sort_order = '05 Q1';
3659       			arm&I. = q1_doses;
3660       			output;
3661       			sort_order = '06 Q3';
3662       			arm&I. = q3_doses;
3663       			output;
3664       			sort_order = '07 P90';
3665       			arm&I. = p90_doses;
3666       			output;
3667       			sort_order = '08 Min';
3668       			arm&I. = min_doses;
3669       			output;
3670       			sort_order = '09 Max';
3671       			arm&I. = max_doses;
3672       			output;
3673       			sort_order = '10 Median-P10';
                                                           The SAS System

3674       			arm&I. = median_doses-p10_doses;
3675       			output;
3676       			sort_order = '11 Q1';
3677       			arm&I. = q1_doses;
3678       			output;
3679       			sort_order = '12 Median - Q1';
3680       			arm&I. = median_doses-q1_doses;
3681       			output;
3682       			sort_order = '13 Q3 - Median';
3683       			arm&I. = q3_doses-median_doses;
3684       			output;
3685       			sort_order = '14 P90 - Median';
3686       			arm&I. = p90_doses-median_doses;
3687       			output;
3688       			sort_order = '15 Q1 - Min';
3689       			arm&I. = q1_doses-min_doses;
3690       			output;
3691       			sort_order = '16 Max - Q3';
3692       			arm&I. = max_doses-q3_doses;
3693       			output;
3694       			sort_order = '17 N';
3695       			arm&I. = n_subjects;
3696       			output;
3697       			sort_order = '18 Mode';
3698       			arm&I. = mode_doses;
3699       			output;
3700       		run;
3701       
3702       		proc sort data = arm&I.;
3703       		  by sort_order;
3704       		run;
3705       
3706       	%end;
3707       
3708       
3709       	data final;
3710       	  merge arm:;
3711       	  by sort_order;
