3398       /****************************************/
3399       /* 2. ANALYSIS B: DISTRIBUTION OF DOSES */
3400       /****************************************/
3401       %macro ex_2;
3402       
3403       	%put ****************************************;
3404       	%put * 2. ANALYSIS B: DISTRIBUTION OF DOSES *;	
3405       	%put ****************************************;
3406       
3407       	** NOW DO THE DOSE BUCKET ANALYSIS ***;
3408       
3409       	** SUMMARIZE BY ID TO GET THE CUMMULATIVE NUMBER OF DOSES ****;
3410       	proc summary data = ex_dm nway;
3411       	  class usubjid;
3412       	  id arm;
3413       	  var doses;
3414       	  output out = by_usubjid(drop = _type_ _freq_) sum=;
3415       	run;
3416       
3417       
3418       	** NOW GET THE MAX DOSES FOR EACH ARM **;
3419       
3420       	proc sort data = by_usubjid;
3421       	  by arm decending doses;
3422       	run;
3423       
3424       	data max_doses;
3425       	  set by_usubjid;
3426       	  by arm;
3427       	if first.arm;
3428       	max_doses = doses;
3429       	drop usubjid doses;
3430       	run;
3431       
3432       
3433       
3434       
3435       	** MERGE ON ***;
3436       
3437       	proc sql;
3438       	  create table by_usubjid2
3439       	  as select b.*, m.*
3440       	  from by_usubjid b, max_doses m
3441       	  where b.arm = m.arm and
                                                           The SAS System

3442       	  b.doses > 0
3443       	  ;
3444       	quit;
3445       
3446       	** DETERMINE THE PECENTS FOR EACH PERSON ***;
3447       
3448       	data by_usubjid2;
3449       	  set by_usubjid2;
3450       
3451       	percent = round(doses/max_doses,.01);
3452       	run;
3453       
3454       	** NUMBER WITH EACH AMOUNT OF DOSE percents ***;
3455       
3456       	proc summary data = by_usubjid2 nway;
3457       	  class arm percent;
3458       	  output out = by_doses(drop=_type_ rename=_freq_=subjects);
3459       	run;
3460       
3461       	** NOW GO AND MAKE SURE ALL PERCENTS FROM 0 to 100 ARE IN THE DATASET FOR EACH ARM ***;
3462       
3463       	data by_doses2(rename=(subjects2=subjects percent2=percent));
3464       		  set by_doses;
3465       		  by arm;
3466       		percent0 = lag(percent);
3467       		if first.arm then do;
3468       		if percent > 0 then do;
3469       		  do J = 0 to percent-.01 by .01;
3470       		    percent2 = J;
3471       			subjects2 = 0;
3472       			output;
3473       		  end;
3474       		 percent2 =percent;
3475       		 subjects2 = subjects;
3476       		 output;
3477       		end;
3478       		else do;
3479       		 percent2 = percent;
3480       		 subjects2 = subjects;
3481       		 output;
3482       		end;
3483       		end;
3484       		else do;
3485       		 if round((percent - percent0),.01) = .01 then do;
3486       		   percent2 = percent;
3487       		   subjects2 = subjects;
3488       		   output;
3489       		 end;
3490       		 else do;
3491       		  do I = percent0 to percent-.01 by .01;
3492       		    percent2 = I;
3493       			subjects2 = 0;
3494       			output;
3495       		  end;
3496       		  percent2 = percent;
3497       		  subjects2 = subjects;
3498       		  output;
3499       		 end;
                                                           The SAS System

3500       		end;
3501       		drop I j percent0 percent subjects;
3502       	run;
3503       
3504       	proc summary data = by_doses2 nway;
3505       	  class arm percent;
3506       	  var subjects;
3507       	  output out = by_doses2(drop=_type_ _freq_) sum=;
3508       	run;
3509       
3510       
3511       
3512       
3513       	** NUMBER BY EACH ARM ***;
3514       	proc summary data = by_usubjid2 nway;
3515       	  class arm;
3516       	  output out = by_treatment(drop = _type_ rename=(_freq_=num_treatment));
3517       	run;
3518       
3519       	data by_treatment;
3520       	  set by_treatment;
3521       	arm_n = _n_;
3522       	run;
3523       
3524       	** MERGE TO GET THE NUMBERATOR AND DENOMINATOR ON SAME DATASET ***;
3525       
3526       	data by_doses_percs;
3527       	  merge by_doses2 by_treatment;
3528       	  by arm;
3529       	  n_percent = subjects / num_treatment;
3530       	run;
3531       
3532       
3533       	** GET CUMMULATIVE PERCENT ***;
3534       	data by_doses_percs;
3535       		  set by_doses_percs;
3536       		  by arm;
3537       		  retain cum_percent;
3538       
3539       		if first.arm then cum_percent = 1;
3540       		cum_percent = sum(cum_percent, - n_percent);
3541       	run;
3542       
3543       
3544       	** LOOP TO FIGURE OUT NUMBER OF PERCENTS BY ARM ***;
3545       	%do n = 1 %to &num_treatments;
3546       
3547       		data treatment;
3548       		  set num_treatments;
3549       		if _N_ = &N;
3550       		run;
3551       
3552       
3553       		proc sql noprint;
3554       		  select arm into: treatment
3555       		  from treatment;
3556       		quit;
3557       
                                                           The SAS System

3558       		data _null_;
3559       		  set max_doses;
3560       		if arm = "&treatment.";
3561       		call symput('MD',max_doses);
3562       		run;
3563       
3564       		data _null_;
3565       		treatment2 = trim(compress("&treatment.",'.'))||' (Max Doses = '||compress("&MD.")||')';
3566       		call symput('treatment2',treatment2);
3567       		run;
3568       
3569       		%put &treatment2.;
3570       
3571       		data by_doses_percs&N.;
3572       		  set by_doses_percs;
3573       
3574       		if arm = "&treatment.";
3575       		cum_percent&N. = cum_percent;
3576       		percent= round(percent,.01);
3577       		label cum_percent&N = "&treatment2.";
3578       		arm&N = arm;
3579       
3580       		keep percent cum_percent&N. ;
3581       		run;
3582       
3583       	%end;
3584       
3585       
3586       	** MERGE BACK ALL THE DATASETS ***;
3587       
3588       	data final_ExposureB;
3589       		merge
3590       		%do S = 1 %to &num_treatments;
3591       		  by_doses_percs&S.
3592       		%end;
3593       		;
3594       		by percent;
3595       	run;
3596       
3597       %mend ex_2;
3598       
