35         
36         title;
37         
38         proc fcmp outlib=work.functions.char; /*3*/
39            function StateProv(Country $,Code $) $ 5;
40         	   if upcase(country) ='AU' then stpr=put(code,$postabb.);
41         	   else if upcase(country)='US' then stpr=zipstate(code);
42         	   else stpr=' ';
43               return(stpr);
44            endsub;
                                                           The SAS System

45         quit;

