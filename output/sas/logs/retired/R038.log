15         /* pick up the sysparm value from the command line this enables the rest of the code to be OFF by default
16         * and only if a user enters the correct value below will the log/list file be copied to the project folder
17         ************************************************************/
18         data _null_;
19             prod="&sysparm";
20             prod =lowcase(prod);
21             prod =compress(prod);
22             prod_key=0;
23             /*** we want to create two types of namig conventions - prod and CR (code review)
24             **** for prod or CR - we simply need the leading values in sysparm to match
25             **************************************************************************/
26             if prod in :('yes','live','prod','production','y','1') then do;
27                prod_key=1;
28             end;
29             if prod in :('code','codereview','cr','2') then do;
30                prod_key=2;
31             end;
32             call symput('cpy_sys_prod',prod_key);
33         run;

