36         /*** we are going to prep and clean up the sas code path and sas code execution .sas ***/
                                                           The SAS System

37         data _null_;
38         
39               /** get the file name from the path ***/
40               length temp_file_name  $700.;
41               length temp_file_name2 $700.;
42               length code_name       $250.;
43               temp_file_name ="&cpy_sys_path";
44         
45               /** need to reverse to isolate the actual name ***/
46               temp_file_name_r=reverse(temp_file_name);
47               temp_file_name2 =scan(temp_file_name_r,1,'\');  /** you may need to adjust the back/forward slash to your os **/
48         
49               /** reversing back to final output name ***/
50               temp_file_name2=reverse(temp_file_name2);
51               temp_file_name2=left(temp_file_name2);
52               temp_file_name2=compress(temp_file_name2);
53               temp_file_name2=trimn(temp_file_name2);
54               xlen=length(temp_file_name2);
55               code_name=substr(temp_file_name2,1,250);
56               code_name=scan(code_name,1,'.');
57         
58               zalen=(length(temp_file_name)) - xlen;
59         
60               fnl_path=substr(temp_file_name,1,zalen);
61               fnl_path=compress(fnl_path);
62               fnl_path=compbl(fnl_path);
63               call symputx('cpy_fnl_path',fnl_path);
64               call symputx('cpy_code_name_x',code_name);
65         run;

