68         %macro dnull(job_class=);
69         
70         /*** we will bring together the facts we need and append to revised log and list names ***/
71             data _null_;
72                  /* get the system date and set format for it as yyyymmdd10
73                  *************************************/
74                  length tdate 8.;
75                  format tdate yymmdd10.;
76                  tdate="&sysdate9"d;
77                  length fdate $20.;
78                  fdate=tdate;
79                  fdate=put(tdate, yymmdd10.);
80                  fdate=tranwrd(fdate,"-","_");
81                  fdate=compress(fdate,"_");
82         
83                  /* get the system time and compress
                                                           The SAS System

84                  ***************************/
85                  length stime $15.;
86                  stime="&systime";
87                  stime=compress(stime,":");
88         
89                  * prepare the new log and list names using the new prefix code name now
90                  * add that to the final string of chars to get a useable set of file names
91                  ******************************************/
92                  length code_list $3500.;
93                  length code_log  $3500.;
94                  cpath="&cpy_fnl_path";
95                  cfile="&cpy_code_name_x";
96                  csval="&sysparm";
97                  code_list ="'" !!  cpath !! fdate !! "_" !! stime !! "_" !! csval  !! "_" !! cfile  !! ".lst" !!   "'";
98                  code_log  ="'" !!  cpath !! fdate !! "_" !! stime !! "_" !! csval  !! "_" !! cfile  !! ".log" !!   "'";
99                  code_list =compress(code_list);
100                 code_log  =compress(code_log);
101                 call symputx('cpy_sys_list',code_list);
102                 call symputx('cpy_sys_log' ,code_log);
103            run;
104        
105        
106            /* execute the new file names for both log and list */
107            proc printto print = &cpy_sys_list  new;
108            run;
109        
110            proc printto   log = &cpy_sys_log   new;
111            run;
112        %mend;  *** end dnull macro;
