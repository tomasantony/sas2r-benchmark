48         %macro cat_summary(var=, lbl=);
49           proc freq data=itt noprint;
50             tables ARM*&var. / out=_&var. (drop=percent) outpct;
51           run;
52           data _&var._fmt;
53             set _&var.;
54             length stat $40 row $40;
55             stat = catx(" ", put(count, 3.), cats("(", put(pct_row, 5.1), "%)"));
56             row  = "&lbl.";
57             keep ARM &var. stat row;
58           run;
59         %mend;
