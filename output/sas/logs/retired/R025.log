108        
109        *3. Calculate qx dr p [qx=Proportion dying
110                               dr=death rate
111                                p=1-qx];
112        Data test1;	
113           Set tests;
114           Length qx dr p 8;
115           If Years=1 then Do;
116             dr=deaths/births;
117        	 qx=deaths/births;
118           End;
119           Else Do;
120             dr=deaths/population;
121             If agegroup=1 then qx=2*4*dr/(2+4*dr);
122        	 Else If agegroup=75 then qx=1.000000;
123             Else qx=2*5*dr/(2+5*dr);
124             End;
125           p=1-qx;
126           Format qx dr p 8.5;
127        Run;

