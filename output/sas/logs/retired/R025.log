163        Data test3;
164           Set test2;
165           Length LagIx dx Lx 8;
166           LagIx=lag(Ix);
167           if Agegroup=75 then LagIx=0;
168           dx = Ix -LagIx;
169           Lx=years*lagIx + dx*ax;
170           Format LagIx dx Lx comma8.0;
171        Run;

