215        
216            %macro boxplot_each_param_tp(plotds=css_anadata, cleanup=1);
217        
218              %local pdx tdx css_pval_ds;
219        
220              %do pdx = 1 %to &paramcd_n;
221        
222                /*** LOOP 1 *****************************************************
223                 *** Loop through each PARAMETER, working with ALL TIMEPOINTS ***
224                 ****************************************************************/
225                  data css_nextparam;
226                    set &plotds (where=(paramcd = "&&paramcd_val&pdx"));
227                  run;
228        
229                %*--- Analysis Timepoints for this parameter: Num (&ATPTN_N), Names (&ATPTN_VAL1 ...) and Labels (&ATPTN_LAB1 ...) ---*;
230                  %util_labels_from_var(css_nextparam, atptn, atpt)
231        
232                %*--- Y-AXIS alternative: Fix Y-Axis MIN/MAX based on all timepoints for PARAM. See Y-AXIS DEFAULT, below. ---*;
233                %*   %util_get_var_min_max(css_nextparam, &c_var, chg_min_max)   *;
234        
235        
236                %do tdx = 1 %to &atptn_n;
237        
238                  /*** LOOP 2 ********************************************************************
239                   *** Loop through each TIMEPOINT for this parameter, working with ALL VISITS ***
240                   *** NB: PROC SORT here is REQUIRED in order to merge on STAT details, below ***
241                   *******************************************************************************/
242                    proc sort data=css_nextparam (where=(atptn = &&atptn_val&tdx))
243                               out=css_nexttimept;
244                      by avisitn &tn_var;
245                    run;
246        
247                  %*--- Y-AXIS DEFAULT: Set Y-Axis MIN/MAX based on this timepoint. See Y-AXIS alternative, above. ---*;
248                    %util_get_var_min_max(css_nexttimept, &c_var, chg_min_max)
249        
250                  %*--- Create format string to display MEAN and STDDEV to default sig-digs: &UTIL_VALUE_FORMAT ---*;
251                    %util_value_format(css_nexttimept, &c_var)
252        
253                  %*--- Create macro variable BOXPLOT_BLOCK_RANGES, to subset visits into box plot pages ---*;
254                    %util_boxplot_block_ranges(css_nexttimept, blockvar=avisitn, catvars=&tn_var);
255        
256        
257                  *--- Calculate summary statistics, KEEP LABELS of VISIT and TRT for plotting, below ---*;
258                    proc summary data=css_nexttimept noprint;
259                      by avisitn &tn_var avisit &t_var;
260                      var &c_var;
261                      output out=css_stats (drop=_type_ _freq_)
262                             n=n mean=mean std=std median=median min=datamin max=datamax q1=q1 q3=q3;
263                    run;
264        
265        
266                  %*--- Add ANCOVA p-values for Endpoint: CHG = BASE + TRT (if user specified a reference arm) ---*;
267                    %if %length(&b_var) > 0 and %length(&ref_trtn) > 0 %then %do;
268                      %local endpoint_definition;
269        
270                      %let css_pval_ds = css_pvalues;
271                      %let endpoint_definition = avisitn = &e_visn;
272        
273                      ods select parameterestimates;
274                      ods output parameterestimates = &css_pval_ds;
275        
276                      proc glm data=css_nexttimept;
277                        where &endpoint_definition;
278                        class &tn_var (ref="&ref_trtn");
279                        model &c_var = &b_var &tn_var / solution;
280                      run; quit;
281        
282                      *--- UPDATE CSS_STATS with p-values for active arms, at Endpoint visit ---*;
283                        data temp;
284                          *--- We simply need the structure of these vars, for subsequent merge ---*;
285                          set css_stats (keep=avisitn &tn_var);
286                          STOP;
287                        run;
288        
289                        data &css_pval_ds;
290                          set temp &css_pval_ds (keep=parameter probt
291                                                 rename=(probt=pval)
292                                                 where=(parameter=:"%upcase(&tn_var)"));
293                          label pval="GLM ANCOVA p-value: Reference is %upcase(&tn_var) = &ref_trtn";
294                          &endpoint_definition;
295                          &tn_var = input(scan(parameter,-1,' '), best8.);
296                        run;
297        
298                        proc sort data=&css_pval_ds;
299                          by avisitn &tn_var;
300                        run;
301        
302                        data css_stats;
303                          merge css_stats &css_pval_ds (keep=avisitn &tn_var pval);
304                          by avisitn &tn_var;
305                        run;
306        
307                        %util_delete_dsets(temp);
308                    %end;
309        
310        
311                  /***
312                    STACK statistics (do NOT merge) BELOW the plot data, one obs per TREATMENT/VISIT.
313                    NB: We need exactly ONE obs per timepoint and trt: AXISTABLE defaults to a SUM function
314                  ***/
315                    data css_plot;
316                      set css_nexttimept
317                          css_stats;
318        
319                      format mean %scan(&util_value_format, 1, %str( )) std %scan(&util_value_format, 2, %str( ));
320                    run;
321        
322        
323                  *--- Graphics Settings - Set defaults for all graphs, MISSING=' ' since most P-VALUEs are missing ---*;
324                    options orientation=landscape missing=' ';
325                    goptions reset=all;
326        
327                    ods graphics on / reset=all;
328                    ods graphics    / border=no attrpriority=COLOR;
329        
330                    title     justify=left height=1.2 "Box Plot - &&paramcd_lab&pdx Change from %upcase(&B_VISN_LAB1) to %upcase(&E_VISN_LAB1) by Visit, Analysis Timepoint: &&atptn_lab&tdx";
