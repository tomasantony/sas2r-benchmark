122        %macro prcnt(num=,denom=,pctd=pctd,pctfmt=4.0);
123          do;
124            length &pctd $9;
125        	if &num = 0 and &denom = 0 then &pctd='';
126        	else do;
127        	  if &num = 0 then &pctd = '';
128              else &pctd = '(' || compress(put(100*&num/&denom,&pctfmt)) || '%)';
129        	end;
130        	&pctd = right(&pctd);
131          END;
132        %mend;
