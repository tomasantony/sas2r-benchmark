134        %macro descrstats(indata=, outdata=, varn=, dec=, name=, ord=);
135           proc sort data=&indata out=__indata;
136              by __dummytrt;
137           run;
138        
139           proc means data=__indata noprint;
140              by __dummytrt;
141        	  var &varn;
