192        %macro freqstats(indata=, outdata=, var=, varfmt=, ordfmt=, name=, ord=);
193          proc freq data = &indata noprint;
194            tables &var*__dummytrt / out = __frout (drop = percent);
195          run;
196        
197          proc sql noprint;
198            %do i=1 %to &trtnum;
199               select count(usubjid) into: denom&i from &indata where ^missing(&var) and __dummytrt = &i;
200        	%end;
201          quit;
202        
203          proc sort data = __frout;
204            by &var;
205          run;
206        
207          proc transpose data = __frout out = __trout_fr (drop = _LABEL_ _NAME_ ) prefix=n;
208            var count;
209            id __dummytrt;
210            by &var;
211          run;
212        
213          data denom;
214             &var = "N";
215             %do i=1 %to &trtnum;
216        	     n&i = &&denom&i;
217        	 %end;
218          run;
219        
220          data &outdata;
221            set __trout_fr denom;
222            length name col0 $200 col1-col&trtnum $50;
