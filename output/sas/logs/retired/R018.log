285        
286            %macro boxplot_each_param_tp(plotds=css_anadata, cleanup=1);
287        
288              %local pdx tdx css_pval_a css_pval_p;
289        
290              %do pdx = 1 %to &paramcd_n;
291        
292                /*** LOOP 1 *****************************************************
293                 *** Loop through each PARAMETER, working with ALL TIMEPOINTS ***
294                 ****************************************************************/
295                  data css_nextparam;
296                    set &plotds (where=(paramcd = "&&paramcd_val&pdx"));
297                  run;
298        
299                %*--- Analysis Timepoints for this parameter: Num (&ATPTN_N), Names (&ATPTN_VAL1 ...) and Labels (&ATPTN_LAB1 ...) ---*;
300                  %util_labels_from_var(css_nextparam, atptn, atpt)
301        
302                %*--- Y-AXIS alternative: Fix Y-Axis MIN/MAX based on all timepoints for PARAM. See Y-AXIS DEFAULT, below. ---*;
303                %*--- NB: EXTRA normal range reference lines could expand Y-AXIS range.                                    ---*;
304                %*   %util_get_var_min_max(css_nextparam, &c_var, aval_min_max)   *;
305        
306        
307                %do tdx = 1 %to &atptn_n;
308        
309                  /*** LOOP 2 ********************************************************************
310                   *** Loop through each TIMEPOINT for this parameter, working with ALL VISITS ***
311                   *** NB: PROC SORT here is REQUIRED in order to merge on STAT details, below ***
312                   *******************************************************************************/
313                    proc sort data=css_nextparam (where=(atptn = &&atptn_val&tdx))
314                               out=css_nexttimept;
315                      by studyid &tn_var;
316                    run;
317        
318                  %*--- Y-AXIS DEFAULT: Set Y-Axis MIN/MAX based on this timepoint. See Y-AXIS alternative, above. ---*;
319                    %util_get_var_min_max(css_nexttimept, &c_var, aval_min_max)
320        
321                  %*--- Create format string to display MEAN and STDDEV to default sig-digs: &UTIL_VALUE_FORMAT ---*;
322                    %util_value_format(css_nexttimept, &c_var)
323        
324                  %*--- Create macro variable BOXPLOT_BLOCK_RANGES, to subset visits into box plot pages ---*;
325                    %util_boxplot_block_ranges(css_nexttimept, blockvar=studynum, catvars=&tn_var);
326        
327        
328                  *--- Calculate summary statistics, KEEP STUDYNUM and TRT LABELS for plotting, below ---*;
329                    proc summary data=css_nexttimept noprint;
330                      by studyid &tn_var studynum &t_var;
331                      var &c_var;
332                      output out=css_stats (drop=_type_ _freq_)
333                             n=n mean=mean std=std median=median min=datamin max=datamax q1=q1 q3=q3;
334                    run;
335        
336        
337                  %*--- Add ANCOVA p-values for Endpoint: CHG = BASE + TRT + STUDY (if user specified a reference arm) ---*;
338                    %if %length(&b_var) > 0 and %length(&ref_trtn) > 0 %then %do;
339                      %let css_pval_a = css_pval_stdy;
340                      %let css_pval_p = css_pval_pool;
341        
342                      *--- For the INDIVIDUAL STUDY DATA, model by STUDYNUM ---*;
343                        ods select parameterestimates;
344                        ods output parameterestimates = &css_pval_a;
345        
346                        proc glm data=css_nexttimept;
347                          class &tn_var (ref="&ref_trtn");
348                          by studynum;
349                          where studyid ^= 'A0'x !! 'Pooled';
350        
351                          model &c_var = &b_var &tn_var / solution;
352                        run; quit;
353        
354                      *--- For the POOLED DATA, include STUDYNUM as an independent effect ---*;
355                        ods select parameterestimates;
356                        ods output parameterestimates = &css_pval_p;
357        
358                        proc glm data=css_nexttimept;
359                          class &tn_var (ref="&ref_trtn");
360                          where studyid = 'A0'x !! 'Pooled';
361        
362                          model &c_var = &b_var &tn_var studynum / solution;
363                        run; quit;
364        
365                      *--- Combine Indiv. Study and Pooled p-values. Keep only results for &TN_VAR parameters ---*;
366                        data &css_pval_a;
367                          set &css_pval_a (where=(parameter=:"%upcase(&tn_var)"))
368                              &css_pval_p (where=(parameter=:"%upcase(&tn_var)") in=in_pool);
369                          if in_pool then studynum = &stdyn;
370                        run;
371        
372        
373                      *--- UPDATE CSS_STATS with p-values for active arms, and for Pooled ---*;
374                        data temp;
375                          *--- We simply need the structure of these vars, for subsequent merge ---*;
376                          set css_stats (keep=studynum &tn_var);
377                          STOP;
378                        run;
379        
380                        data &css_pval_a;
381                          set temp &css_pval_a (keep=studynum parameter probt
382                                                 rename=(probt=pval));
383                          label pval="GLM ANCOVA p-value: Reference is %upcase(&tn_var) = &ref_trtn";
384                          &tn_var = input(scan(parameter,-1,' '), best8.);
385                        run;
386        
387                        proc sort data=&css_pval_a;
388                          by studynum &tn_var;
389                        run;
390        
391                        data css_stats;
392                          merge css_stats &css_pval_a (keep=studynum &tn_var pval);
393                          by studynum &tn_var;
394                        run;
395        
396                        %util_delete_dsets(temp);
397                    %end;
398        
399        
400                    /***
401                      STACK statistics (do NOT merge) BELOW the plot data, one obs per TREATMENT/VISIT.
402                      NB: We need exactly ONE obs per timepoint and trt: AXISTABLE defaults to a SUM function
403                    ***/
404                    data css_plot;
405                      set css_nexttimept
406                          css_stats;
407        
408                      format mean %scan(&util_value_format, 1, %str( )) std %scan(&util_value_format, 2, %str( ));
409                    run;
410        
411        
412                  *--- Graphics Settings - Set defaults for all graphs. Print missing P-VALUES as a space (not a dot) ---*;
413                    options orientation=landscape missing=' ';
414                    goptions reset=all;
415        
416                    ods graphics on / reset=all;
417                    ods graphics    / border=no attrpriority=COLOR;
418        
419                    title     justify=left height=1.2 "Box Plot - &&paramcd_lab&pdx Change from &c_mode Baseline to &c_mode Post-Baseline Measure for Multiple Studies and Analysis Timepoint &&atptn_lab&tdx";
420                    footnote1 justify=left height=1.0 'Box plot type is schematic: the box shows median and interquartile range (IQR, the box height); the whiskers extend to the minimum and maximum data points';
421                    footnote2 justify=left height=1.0 'within 1.5 IQR of the lower and upper quartiles, respectively. Values outside the whiskers are shown as outliers. Means are marked with a different symbol';
422                    footnote3 justify=left height=1.0 'for each treatment. P-value is for the treatment comparison from ANCOVA model Change = Baseline + Treatment (+ Study for "Pooled").';
423        
424                    %let y_axis = %util_axis_order( %scan(&aval_min_max,1,%str( )), %scan(&aval_min_max,2,%str( )) );
425        
426                  *--- ODS PDF destination (Traditional Graphics, No ODS or Listing output) ---*;
427                    ods listing close;
428                    ods pdf file="&outputs_folder\WPCT-F.07.07_Box_plot_&&paramcd_val&pdx.._change_&c_mode._base_post_by_study_for_timepoint_&&atptn_val&tdx...pdf"
429                            notoc bookmarklist=none dpi=300
430                            author="(&SYSUSERID) PhUSE CS Standard Analysis Library"
431                            subject='PhUSE CS Measures of Central Tendency'
432                            title="Boxplot of &&paramcd_lab&pdx Change from &c_mode Baseline to &c_mode Post-baseline Measure for Multiple Studies and Analysis Timepoint &&atptn_lab&tdx"
433                            ;
434        
435        
436                  /*** LOOP 3 - FINALLY, A Graph ****************************
437                   *** - Multiple pages in case of many visits/treatments ***
438                   **********************************************************/
439        
440                    %local vdx nxtvis;
441                    %let vdx=1;
442                    %do %while (%qscan(&boxplot_block_ranges,&vdx,|) ne );
443                      %let nxtvis = %qscan(&boxplot_block_ranges,&vdx,|);
444        
445                      proc sgrender data=css_plot (where=( %unquote(&nxtvis) )) template=PhUSEboxplot ;
446                        dynamic
447                                _MARKERS    = "&t_var"
448                                _BLOCKLABEL = 'studyid'
449                                _XVAR       = 'studynum'
450                                _YVAR       = "&c_var"
451                                _REFLINES   = '0'
452                                _YLABEL     = "&&paramcd_lab&pdx"
453                                _YMIN       = %scan(&y_axis, 1, %str( ))
454                                _YMAX       = %scan(&y_axis, 3, %str( ))
455                                _YINCR      = %scan(&y_axis, 5, %str( ))
456                                _N          = 'n'
457                                _MEAN       = 'mean'
458                                _STD        = 'std'
459                                _DATAMIN    = 'datamin'
460                                _Q1         = 'q1'
461                                _MEDIAN     = 'median'
462                                _Q3         = 'q3'
463                                _DATAMAX    = 'datamax'
464                                _PVAL       = 'pval'
465                                ;
466                      run;
467        
468                      %let vdx=%eval(&vdx+1);
469                    %end; %* --- LOOP 3 - Pages of box plots, VDX ---*;
470        
471                  *--- Release the PDF output file! ---*;
472                    ods pdf close;
473                    ods listing;
474        
475                %end; %*--- LOOP 2 - Time Points, TDX ---*;
476        
477              %end; %*--- LOOP 1 - Parameters, PDX ---*;
478        
479        
480              *--- Clean up temp data sets required to create box plots ---*;
481                %if &cleanup %then %util_delete_dsets(css_safana css_nextparam css_nexttimept &css_pval_a &css_pval_p css_stats css_plot);
482        
483            %mend boxplot_each_param_tp;
484        
485            %boxplot_each_param_tp;
MPRINT(BOXPLOT_EACH_PARAM_TP):   *--- Clean up temp data sets required to create box plots ---*;
