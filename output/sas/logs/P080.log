243        /*--- Step 1: Define subgroups ---*/
244        /* Each subgroup analysis is done separately, then combined */
245        
246        %macro subgroup_analysis(data=, subgrp=, subgrp_label=, paramcd=OS,
247                                  subgrp_ord=, levels=);
248        
249            proc sort data=&data. out=_sg; by &subgrp.; run;
250        
251            /* Run Cox model within each subgroup level */
252            ods output ParameterEstimates = _pe_&subgrp_ord.;
253        
254            proc phreg data=_sg;
255                by &subgrp.;
256                class TRTA(ref="&trt1lbl.");
257                model AVAL * CNSR(1) = TRTA;
258                hazardratio TRTA;
259            run;
260        
261            ods output close;
262        
263            /* Format results */
                                                           The SAS System

264            data _sg_&subgrp_ord.;
265                set _pe_&subgrp_ord.;
266                where Parameter = 'TRTA';
267        
268                length subgroup $60 subgroup_level $60;
269                subgroup = "&subgrp_label.";
270                subgroup_level = strip(vvalue(&subgrp.));
271                subgrp_ord = &subgrp_ord.;
272        
273                HR = exp(Estimate);
274                HR_LCL = exp(Estimate - 1.96 * StdErr);
275                HR_UCL = exp(Estimate + 1.96 * StdErr);
276        
277                /* Display strings */
278                length hr_display $30 ci_display $40;
279                hr_display = strip(put(HR, 5.2));
280                ci_display = cat('(', strip(put(HR_LCL, 5.2)), ', ',
281                                      strip(put(HR_UCL, 5.2)), ')');
282        
283                keep subgroup subgroup_level subgrp_ord HR HR_LCL HR_UCL
284                     hr_display ci_display ProbChiSq;
285            run;
286        
287        %mend subgroup_analysis;
