19         *                             removed full detailed description, added reference
20         *                             to PDF
21         ***********************************************************************;
22         %macro SUPP2PAR_v1(
23           inlib=work,                 /* Name of Input library for Parent and Supplemental Datasets */
24           parent=,                    /* Name of Parent Input Dataset */
25           supp=,                      /* Name of Supplemental Input Dataset */
26           outlib=work,                /* Name of Destination/Output library for Merged dataset */
27           outname=%str(&parent.FULL), /* Name of Merged Output Dataset */
28           clean=Y,                    /* Whether or not (Y/N) to clean work environment at end */
29           dev=N,                      /* Whether or not (Y/N) to show all messages in the log */
30           Info=1,                     /* Level of information to provide in the log:
31                                          1 (all), 2 (start and summary), 3 (only summary) */
32           RC=RC_S2P                   /* Name of Return Code Macro variable */
33         );
34         
35         %* Globalizing the RC macrovariable and setting a local RC_WAR macrovariable
36             Latter increments the Warnings (negative RCs) that do not end the processing
37             Former picks up the terminating RCs, only when no more termination is possible
38             (at the end almost) RC_WAR is put into the RC and reporting is done of the global RC;
39         %global &RC;
40         %let &RC = 99999;
41         %local RC_WAR ;
42         %let RC_WAR = 0;
43         
44         %* Info not in (1 2 3) -> reverts to default;
45         %if %upcase(%trim(&Info)) ne 1 AND %upcase(%trim(&Info)) ne 2 AND %upcase(%trim(&Info)) ne 3 %then %let Info = 1;
46         
47         %* First info in log for Info = 1 OR 2 - obviously nonotes at this stage disables this regardless of Info;
48         %if %upcase(%trim(&Info)) = 1 OR %upcase(%trim(&Info)) = 2 %then %do;
49         data _null_;
50             put "NO" "TE- " " ";
51             put "NO" "TE- " "*****************************";
52             put "NO" "TE- Started Processing for ";
53             put "NO" "TE-  PARENT = %upcase(&inlib..&PARENT.)";
54         	  put "NO" "TE-  SUPP   = %upcase(&inlib..&SUPP.)";
55             put "NO" "TE- " "*****************************";
56         run;
                                                           The SAS System

57         %end;
58         
59         %************************************************************************;
60         %* Turning off LOG Clutter unless specifically marked as development run ;
61         %* Assuring we know the original settings and can recall them later      ;
62         %if %upcase(%quote(&DEV)) ne Y %then %do;
63         %let save_opts=%sysfunc(getoption(SYMBOLGEN))
64            %sysfunc(getoption(MACROGEN)) %sysfunc(getoption(MPRINT))
65            %sysfunc(getoption(MLOGIC)) %sysfunc(getoption(NOTES))
66            %sysfunc(getoption(SOURCE)) %sysfunc(getoption(SOURCE2)) ;
67         options noSYMBOLGEN noMACROGEN noMPRINT noMLOGIC noNOTES noSOURCE noSOURCE2 ;
68         %end;
