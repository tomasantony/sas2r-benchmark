396        %* Checking whether Supplemental dataset has records where either USUBJID and/or RDOMAIN and/or QNAM is empty;
397        %* If so, ignore the record and issue notification(s) in the log with an output dataset to contain the ignored records;
398        %* The processing does continue however;
399        data &supp._IGNOR S2P_&supp._Accept;
400          set &inlib..&supp. (where = (strip(RDOMAIN) = '' or strip(USUBJID) = '' or strip(QNAM) = '') in = a)
401              &inlib..&supp. (where = (not(strip(RDOMAIN) = '' or strip(USUBJID) = '' or strip(QNAM) = '')) in = b) ;
402          if a then output &supp._IGNOR;
403          else if b then output S2P_&supp._Accept;
404        run;
