543        %*Creating a version of supplemental dataset in the WORK library      *;
544        %*And ensuring that IDVAR is not empty, but substituted by USUBJID    *;
545        %local S2P_IDVARE S2P_IDVARNE USUBLEN;
546        
547        * Determining Length of USUBJID (assuming it is always a text variable);
548        * So that it can be assigned as such on IDVARVAL (in order to avoid truncation,
549           because empty IDVARVAL which will be replaced by USUBJID is likely to not
550           have the apropriate length);
551        * 2011-11-16: Addition: Possibly IDVAR has length smaller than length('USUBJID')
552                        in that case adapt, if not leave as is;
553        proc contents noprint data = S2P_&supp._Accept out = S2P_ATT_USUB (where = (NAME = 'USUBJID' OR NAME = 'IDVAR'));
554        quit;
555              %if &syserr > 4 %then %do ;
556                 %put ERROR: &sysmacroname: Procedure Step Error Trapped - Terminating;
557                 %let &rc=600;
558                 %goto S2P_TERMIN ;
559              %end ;
560        
561        data _null_;
562          set S2P_ATT_USUB (keep = LENGTH NAME);
563          if NAME = 'USUBJID' then call symput("USUBLEN","$"!!trim(left(put(LENGTH,best.)))!!".");
564          else if NAME = 'IDVAR' then do;
565          if LENGTH ge length('USUBJID') then call symput("IDVARLEN","$"!!trim(left(put(LENGTH,best.)))!!".");
566        	else call symput("IDVARLEN","$"!!trim(left(put(length('USUBJID'),best.)))!!".");
567          end;
568        run;
569        * End 2011-11-16 addition;
570              %if &syserr > 4 %then %do ;
571                 %put ERROR: &sysmacroname: Data Step Error Trapped - Terminating;
572                 %let &rc=500;
573                 %goto S2P_TERMIN ;
574              %end ;
575        
576        data S2P_&SUPP.;
577          length IDVARVAL &USUBLEN IDVAR &IDVARLEN;
578          set S2P_&supp._Accept;
                                                           The SAS System

579          if IDVAR = '' and IDVARVAL = '' then do;
580            IDVAR = 'USUBJID';
581        	IDVARVAL = USUBJID;
582        	call symput("S2P_IDVARE","1");
583          end;
584          else if IDVAR = '' AND IDVARVAL ne '' then do;
585        	call symput("S2P_IDVARNE","1");
586          end;
587        run;
588              %if &syserr > 4 %then %do ;
589                 %put ERROR: &sysmacroname: Data Step Error Trapped - Terminating;
590                 %let &rc=500;
591                 %goto S2P_TERMIN ;
