409        /*--- Step 2: AE Categories ---*/
410        /* Each row represents a category; count distinct subjects */
411        
412        %macro ae_category(where_clause=, label=, ord=);
413            proc sql noprint;
414                create table _ae&ord. as
415                select a.TRTA,
416                       count(distinct a.USUBJID) as cnt,
417                       "&label." as category length=80,
418                       &ord. as ord
419                from adam.adae a
420                inner join adam.adsl b on a.USUBJID = b.USUBJID
421                where b.SAFFL = 'Y'
422                      and a.TRTEMFL = 'Y'
423                      &where_clause.
424                group by a.TRTA;
425            quit;
426        %mend ae_category;
427        
428        /* Any TEAE */
429        %ae_category(where_clause=,
430                     label=Subjects with at least one TEAE, ord=1);
