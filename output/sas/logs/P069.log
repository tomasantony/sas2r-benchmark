481        proc sql noprint;
482            create table all_ae2 as
483            select a.*,
484                   b.bign,
485                   case when b.bign > 0
486                        then a.cnt / b.bign * 100
487                        else .
488                   end as pct
489            from all_ae a
490            left join work._bign b
491            on a.TRTA = b.TRTA
492            order by ord, TRTA;
