29         proc sql;
30           create table disp as
31         	select distinct TRT01P,TRT01PN, count(usubjid) as cnt, 1 as ord,
32           case
33             when DCREASCD='Completed'  then DCREASCD
34             else 'Discontinued' end as status
35           from adsl
36         	  where ITTFL='Y'
37         	  group by TRT01P, calculated status
38           union all
39         	  select distinct TRT01P,TRT01PN, count(usubjid) as cnt, 2 as ord,
40         	  DCREASCD as status
                                                           The SAS System

41           from adsl
42         	  where ITTFL='Y' and DCREASCD^='Completed'
43         	  group by TRT01P,DCREASCD
44           order by TRT01PN,calculated ord, calculated status
45         ;
NOTE: The query requires remerging summary statistics back with the original data.
NOTE: SAS threaded sort was used.
NOTE: Table WORK.DISP created, with 28 rows and 5 columns.

46         
47           create table freq as
48         	select distinct TRT01PN,count (usubjid) as tot_cnt
49           from adsl
50           group by TRT01PN
51           order by TRT01PN
52         ;
NOTE: Table WORK.FREQ created, with 3 rows and 2 columns.

