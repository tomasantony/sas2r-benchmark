99         data _disp;
100          set ds;
101          by USUBJID DSDTC;
102          where DSCAT = "DISPOSITION EVENT" and DSDECOD ne "SCREEN FAILURE";
103          if last.USUBJID;            /* latest disposition record per subject */
104          length EOSSTT $12 DCSREAS $100 DCSREASP $200;
105          if DSDECOD = "COMPLETED" then do;
106            EOSSTT = "COMPLETED";
107            DCSREAS = "";
108            DCSREASP = "";
109          end;
110          else do;
111            EOSSTT = "DISCONTINUED";
112            DCSREAS = DSDECOD;
113            if DSDECOD = "OTHER" then DCSREASP = DSTERM; else DCSREASP = "";
114          end;
115          keep USUBJID EOSSTT DCSREAS DCSREASP;
116        run;
