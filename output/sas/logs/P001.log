168            from qs
169            where QSTESTCD = "ACTOT"
170              and QSCAT    = "ALZHEIMER'S DISEASE ASSESSMENT SCALE"
171              and not missing(QSSTRESN)
172              and upcase(VISIT) ne "BASELINE"
173              and not index(upcase(VISIT), "SCREENING");
