263        /*--- Step 2: Compute summary statistics by visit and treatment ---*/
264        proc means data=eff nway noprint;
265            class TRTA TRTAN AVISIT AVISITN;
266            var CHG;
267            output out=stats(drop=_type_ _freq_)
268                n=n mean=mean stderr=se
269                lclm=lcl uclm=ucl;
270        run;

