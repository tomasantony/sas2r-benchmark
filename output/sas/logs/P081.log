242        /*--- Parameters ---*/
243        %let eff_param = ACTOT;   /* test copy: placeholder filled with the synthetic efficacy parameter */    /* Analysis
243      ! parameter */
244        %let y_label   = Change from Baseline in ADAS-Cog Total Score;
245        
246        /*--- Step 1: Prepare analysis data ---*/
247        proc sql noprint;
248            create table eff as
249            select a.USUBJID, a.TRTA, a.TRTAN,
250                   a.PARAMCD, a.PARAM,
251                   a.AVISIT, a.AVISITN,
252                   a.AVAL, a.BASE, a.CHG,
253                   a.ANL01FL
254            from adam.adeff a
255            inner join adam.adsl b on a.USUBJID = b.USUBJID
256            where b.EFFFL = 'Y'
257                  and a.PARAMCD = "&eff_param."
258                  and a.ANL01FL = 'Y'
259                  and a.CHG ne .
260            order by a.TRTAN, a.AVISITN;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.EFF created, with 650 rows and 11 columns.
