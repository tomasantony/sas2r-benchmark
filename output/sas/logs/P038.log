130        
131        *** Transpose to 1 record per baseline category and compute percentage;
132        data trans (keep=param paramn &trtvar bnrindn bnrind n1-n&maxcat pct1-pct&maxcat denom trttx);
133          array ns(*) n1-n&maxcat;
134          array pcts(*) $7 pct1-pct&maxcat;
135        
136          do until (last.bnrindn);
137            set alldenom;
138        	by param paramn &trtvar bnrindn;
139        
140        	ns(anrindn) = n;
141        	if denom > 0 then pcts(anrindn) = '(' || put(round(((100 * n) / denom), 0.1), 5.1) || ')';
142        	  else pcts(anrindn) = '(  0.0)';
143          end;
144        
145          length trttx $ 30;
146          trttx = catx(' ', put(&trtvar, trtft.), ('(N = ' || compress(put(denom, 12.)) || ')'));
147          output;
148        run;

