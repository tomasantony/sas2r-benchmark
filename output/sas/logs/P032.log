53         /*If you want to calculate Confidence Intervals and be 100% confident that your 95% confidence interval of
54         Mean is correct, it is best that you get your N, Mean and Standard error by any one of the procedures in SAS and
55         then use the TINV function to calculate the Confidence Interval.*/
56         DATA temp1 ;
57         SET temp ;
58         lo = mean - ( TINV ( 0.95 , n-1 ) * stderr ) ;
59         hi = mean + ( TINV ( 0.95 , n-1 ) * stderr ) ;
60         drop _TYPE_  _FREQ_  lclm     uclm stderr;
61         RUN;

