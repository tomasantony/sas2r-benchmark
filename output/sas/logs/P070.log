411        /*--- Step 2: Prepare CM data ---*/
412        proc sql noprint;
413            create table cm as
414            select a.USUBJID, a.TRTA, a.TRTAN,
415                   a.CMCLAS,      /* ATC Level 2 Class */
416                   a.CMDECOD,     /* Preferred medication name */
417                   a.CMINDC,      /* Indication */
418                   a.CMSTDTC, a.CMENDTC
419            from adam.adcm a
420            inner join adam.adsl b on a.USUBJID = b.USUBJID
421            where b.SAFFL = 'Y'
422                  and a.CONCOMFL = 'Y'  /* Concomitant flag */
423            order by a.TRTAN, a.CMCLAS, a.CMDECOD;
