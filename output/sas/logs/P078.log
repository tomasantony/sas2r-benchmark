313        /*--- Step 1: Prepare data ---*/
314        proc sql noprint;
315            create table dv_list as
316            select a.USUBJID,
317                   b.TRTA,
318                   b.SITEID as SITE,
319                   a.DVCAT as CATEGORY,
320                   a.DVSCAT as SUBCATEGORY,
321                   a.DVTERM as DESCRIPTION,
322                   a.DVSTDTC as START_DATE,
323                   a.DVENDTC as END_DATE,
324                   a.EPOCH,
325                   /* Major/Minor classification if available */
326                   a.DVSEV as SEVERITY
327            from sdtm.dv a
328            inner join adam.adsl b on a.USUBJID = b.USUBJID
329            where b.RANDFL = 'Y'
330            order by b.TRTA, b.SITEID, a.USUBJID, a.DVSTDTC;
