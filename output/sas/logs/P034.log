40         %macro target13(PCTESTCD=, Meantype=A, SD=Y);
41         %if %upcase("&PCTESTCD") = " " %then
42           %put %str(E)RROR: Need to specify a variable to test;;
43         %if %upcase("&meantype") ne "G" and %upcase("&meantype") ne "A" %then
44           %put %str(E)RROR: Need to specify either Geometric or Arithmetic option;;
45         %if %upcase("&SD") ne "UPPER" and %upcase("&SD") ne "BOTH" and %upcase("&SD") ne "N"  %then
46           %put %str(E)RROR: Need to specify Upper, Both or No Bars;;
47         
48         
49         data work.adpc ;
50         set source.adpc(keep=ANLPRNT TRTAN ANLPRNT PCSPEC PCTESTL TRTA DOSREFID PCTESTCD
51                              PCORRESU PCORRES USUBJID  PCORRESN EPLTM);
52         
53           where PCTESTCD="&PCTESTCD";
54           PCTPT=input(EPLTM,best10.);
55           ORDERBY=compress( ANLPRNT||PCSPEC||PCTESTL||TRTAN); 	
56           BYVAL6=compbl(propcase(pctestcd)||' Conc '||' ('||PCORRESU||')');
57         run ;
