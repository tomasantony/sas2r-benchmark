64         
65           proc univariate data=ADPC noprint;
66              by TRTAN TRTA PCTPT;
67              var PCORRESN;
68         	 output out=PCMEANS mean=PCmean STD=PCSD ;
69           run;
70         
71           data MeanData;
72             set PCMEANS;
73         	if PCMEAN=0 then do;
74         	   PCMEAN=.;
75         	   PCSD=.;
76         	end;
77           run;
78         %end;
79         
80         %if &meantype=G %then %do;
81         
82           data LOGPC;
83             set ADPC;
84         	if PCORRESN ne . then LOGORRES=log(PCORRESN);
85           run;
86         
87           proc univariate data=LOGPC noprint;
88              by TRTAN TRTA PCTPT;
89              var PCORRESN;
90         	 output out=LogMEANS mean=Logmean STD=logSD ;
91           run;
92         
93           data MeanData;
94             set LogMEANS;
95             PCMEAN=EXP(LogMEANS);
96             PCSD=EXP(logSD);
