313        /*--- Step 1: Prepare listing data ---*/
314        proc sql noprint;
315            create table ae_list as
316            select a.USUBJID,
317                   b.TRTA,
318                   b.AGE, b.SEX, b.RACE,
319                   a.AEBODSYS as SOC,
320                   a.AEDECOD as PT,
321                   a.AETERM as VERBATIM,
322                   a.AESTDTC as START_DATE,
323                   a.AEENDTC as END_DATE,
324                   a.AESEV as SEVERITY,
325                   a.AEREL as RELATIONSHIP,
326                   a.AESER as SERIOUS,
327                   a.AEACN as ACTION_TAKEN,
328                   a.AEOUT as OUTCOME,
329                   a.AETOXGR as CTCAE_GRADE,
330                   a.TRTEMFL
331            from adam.adae a
332            inner join adam.adsl b on a.USUBJID = b.USUBJID
333            where b.SAFFL = 'Y' and a.TRTEMFL = 'Y'
334            order by b.TRTA, a.USUBJID, a.AESTDTC, a.AEBODSYS, a.AEDECOD;
