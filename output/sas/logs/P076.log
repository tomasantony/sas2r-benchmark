337        /*--- Step 2: Format display values ---*/
338        data ae_report;
339            set ae_list;
340            length severity_d $10 rel_d $15 serious_d $3 action_d $30 outcome_d $30;
341        
342            /* Truncate/format for display */
343            severity_d = propcase(SEVERITY);
344            rel_d = propcase(RELATIONSHIP);
345            serious_d = ifc(SERIOUS = 'Y', 'Yes', 'No');
346        
347            select(upcase(ACTION_TAKEN));
348                when('DRUG WITHDRAWN')     action_d = 'Drug Withdrawn';
349                when('DOSE REDUCED')       action_d = 'Dose Reduced';
350                when('DRUG INTERRUPTED')   action_d = 'Drug Interrupted';
351                when('DOSE NOT CHANGED')   action_d = 'Dose Not Changed';
352                when('NOT APPLICABLE')     action_d = 'Not Applicable';
353                otherwise                  action_d = propcase(ACTION_TAKEN);
354            end;
355        
356            select(upcase(OUTCOME));
357                when('RECOVERED/RESOLVED')            outcome_d = 'Resolved';
358                when('RECOVERING/RESOLVING')          outcome_d = 'Resolving';
359                when('NOT RECOVERED/NOT RESOLVED')    outcome_d = 'Not Resolved';
360                when('RECOVERED/RESOLVED WITH SEQUELAE') outcome_d = 'Resolved w/ Sequelae';
361                when('FATAL')                         outcome_d = 'Fatal';
362                otherwise                             outcome_d = propcase(OUTCOME);
363            end;
364        run;

