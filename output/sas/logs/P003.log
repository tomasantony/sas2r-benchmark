80         ** GET RESULTS AT SUBJECT LEVEL **;
81         create table RESULTSUB as select a.*, 1 as SUMMARYLEVEL, b.DENOM, c.events,
                                                           The SAS System

82         strip(put(count,best.))||' ('||strip(put((count/denom)*100,8.1))||'%) ['||strip(put(events,best.))||']'
