17         ** GET DESCRIPTIVE STATISTICS - COUNTS FREQUENCIES AND UNIQUE COUNTS AT SUBJECT, SOC AND PT LEVELS**;
18         PROC SQL;
19         CREATE TABLE DENOM AS
20         SELECT COUNT(distinct usubjid) as denom, TRT01AN as TRTAN
21         FROM ADSL(where=(SAFFL='Y'))
22         GROUP BY TRTAN
23         ORDER BY TRTAN;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.DENOM created, with 3 rows and 2 columns.

24         /* COUNT UNIQUE SUBJECTS BY SOC AND PREFERRED TERM AND TREATMENT */
25         CREATE TABLE AEPTD AS
26         SELECT COUNT(distinct usubjid) AS count, AEBODSYS, AEDECOD, TRTAN
27         FROM ADAE(where=(TRTEMFL='Y' and AESER='Y'))
28         GROUP BY TRTAN, AEBODSYS, AEDECOD
29         ORDER BY TRTAN, AEBODSYS, AEDECOD;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.AEPTD created, with 3 rows and 4 columns.

30         ** COUNT ALL EVENTS BY SOC AND PREFERRED TERM AND TREATMENT **;
31         CREATE TABLE AEPTA AS
32         SELECT COUNT(usubjid) AS events, AEBODSYS, AEDECOD, TRTAN
33         FROM ADAE(where=(TRTEMFL='Y' and AESER='Y'))
34         GROUP BY TRTAN, AEBODSYS, AEDECOD
35         ORDER BY TRTAN, AEBODSYS, AEDECOD;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.AEPTA created, with 3 rows and 4 columns.

36         ** GET RESULTS AT PTLEVEL **;
37         create table RESULTPT as select a.*, 3 as SUMMARYLEVEL, b.DENOM, c.events,
38         strip(put(count,best.))||' ('||strip(put((count/denom)*100,8.1))||'%) ['||strip(put(events,best.))||']'
39         as RESULT LENGTH=50
40         from AEPTD as A left join DENOM as b
41         on a.TRTAN=b.TRTAN
                                                           The SAS System

42         left join AEPTA as c
43         on a.TRTAN=c.TRTAN and a.AEBODSYS=c.AEBODSYS and a.AEDECOD=c.AEDECOD
44         order by AEBODSYS, AEDECOD, TRTAN;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.RESULTPT created, with 3 rows and 8 columns.

45         
46         /* COUNT UNIQUE SUBJECTS BY SOC AND TREATMENT */
47         CREATE TABLE AESOCD AS
48         SELECT COUNT(distinct usubjid) AS count, AEBODSYS, TRTAN
49         FROM ADAE(where=(TRTEMFL='Y' and AESER='Y'))
50         GROUP BY TRTAN, AEBODSYS
51         ORDER BY TRTAN, AEBODSYS;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.AESOCD created, with 2 rows and 3 columns.

52         ** COUNT ALL EVENTS BY SOC TREATMENT **;
53         CREATE TABLE AESOCA AS
54         SELECT COUNT(usubjid) AS events, AEBODSYS, TRTAN
55         FROM ADAE(where=(TRTEMFL='Y' and AESER='Y'))
56         GROUP BY TRTAN, AEBODSYS
57         ORDER BY TRTAN, AEBODSYS;
NOTE: SAS threaded sort was used.
NOTE: Table WORK.AESOCA created, with 2 rows and 3 columns.

58         ** GET RESULTS AT SOCLEVEL **;
59         create table RESULTSOC as select a.*, 2 as SUMMARYLEVEL, b.DENOM, c.events,
60         strip(put(count,best.))||' ('||strip(put((count/denom)*100,8.1))||'%) ['||strip(put(events,best.))||']'
61         as RESULT LENGTH=50
62         from AESOCD as A left join DENOM as b
63         on a.TRTAN=b.TRTAN
64         left join AESOCA as c
65         on a.TRTAN=c.TRTAN and a.AEBODSYS=c.AEBODSYS
66         order by AEBODSYS, TRTAN;
