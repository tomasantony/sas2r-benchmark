313        /*--- Step 1: Prepare SAE listing data ---*/
314        proc sql noprint;
315            create table sae_list as
316            select a.USUBJID,
317                   b.TRTA, b.AGE, b.SEX, b.RACE,
318                   b.TRTSDT format=date9. as TRT_START,
319                   a.AEBODSYS as SOC,
320                   a.AEDECOD as PT,
321                   a.AETERM as VERBATIM,
322                   a.AESTDTC as START_DATE,
323                   a.AEENDTC as END_DATE,
324                   a.AETOXGR as GRADE,
325                   a.AEREL as RELATIONSHIP,
326                   a.AEACN as ACTION_TAKEN,
327                   a.AEOUT as OUTCOME,
328                   /* SAE criteria */
329                   a.AESDTH,     /* Results in death */
330                   a.AESLIFE,    /* Life threatening */
331                   a.AESHOSP,    /* Requires hospitalization */
332                   a.AESDISAB,   /* Results in disability */
333                   a.AESCONG,    /* Congenital anomaly */
334                   a.AESMIE      /* Other medically important */
                                                           The SAS System

335            from adam.adae a
336            inner join adam.adsl b on a.USUBJID = b.USUBJID
337            where b.SAFFL = 'Y'
338                  and a.AESER = 'Y'
339            order by b.TRTA, a.USUBJID, a.AESTDTC;
