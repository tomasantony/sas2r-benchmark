342        /*--- Step 2: Derive SAE criteria display ---*/
343        data sae_report;
344            set sae_list;
345            length sae_criteria $200;
346        
347            sae_criteria = '';
348            if AESDTH = 'Y'   then sae_criteria = catx(', ', sae_criteria, 'Death');
349            if AESLIFE = 'Y'  then sae_criteria = catx(', ', sae_criteria, 'Life-threatening');
350            if AESHOSP = 'Y'  then sae_criteria = catx(', ', sae_criteria, 'Hospitalization');
351            if AESDISAB = 'Y' then sae_criteria = catx(', ', sae_criteria, 'Disability');
352            if AESCONG = 'Y'  then sae_criteria = catx(', ', sae_criteria, 'Congenital anomaly');
353            if AESMIE = 'Y'   then sae_criteria = catx(', ', sae_criteria, 'Medically important');
354        
355            /* Days from first dose to onset */
356            length onset_day $20;
357            if TRT_START ne . and input(START_DATE, ??yymmdd10.) ne . then do;
358                _onset = input(START_DATE, yymmdd10.) - TRT_START + 1;
359                onset_day = strip(put(_onset, 8.));
360            end;
361            else onset_day = '';
362        
363            /* Demographics string */
364            length demog $40;
365            demog = catx('/', strip(put(AGE, best.)), strip(SEX), strip(substr(RACE, 1, 1)));
366        run;

