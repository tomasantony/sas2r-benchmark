603        /*--- Step 4: Merge actual and change ---*/
604        proc sql noprint;
605            create table stats as
606            select a.*,
607                   b.n_chg, b.mean_chg, b.std_chg, b.median_chg,
608                   b.min_chg, b.max_chg
609            from _actual a
610            left join _change b
611            on a.PARAMCD = b.PARAMCD and a.AVISITN = b.AVISITN and a.TRTAN = b.TRTAN
612            order by a.PARAMN, a.AVISITN, a.TRTAN;
