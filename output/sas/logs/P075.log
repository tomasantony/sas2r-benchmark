571        /*--- Step 2: Prepare analysis data ---*/
572        proc sql noprint;
573            create table vs as
574            select a.USUBJID, a.TRTA, a.TRTAN,
575                   a.PARAMCD, a.PARAM, a.PARAMN,
576                   a.AVISIT, a.AVISITN,
577                   a.AVAL, a.BASE, a.CHG,
578                   a.ABLFL, a.ANL01FL
579            from adam.advs a
580            inner join adam.adsl b on a.USUBJID = b.USUBJID
581            where b.SAFFL = 'Y'
582                  and a.PARAMCD in ('SYSBP', 'DIABP', 'PULSE', 'TEMP', 'RESP', 'WEIGHT')
583                  and a.ANL01FL = 'Y'  /* Analysis-relevant records */
584            order by a.PARAMN, a.AVISITN, a.TRTAN;
