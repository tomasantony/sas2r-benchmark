118        data Round;
119        set Channel1;
120           Round     = round(Length, 0.1);    /* traditional: round to nearest tenth */
121           RoundEven = rounde(Length, 0.1);   /* use round-to-even method to round to nearest tenth */
122           /* create a binary indicator variable: Was x rounded up or down? */
123           RoundUp     = (Round > Length);    /* 1 if rounded up; 0 if rounded down */
124           RoundEvenUp = (RoundEven > Length);
125        run;

